<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RazorLangVersion>Latest</RazorLangVersion>
		<UserSecretsId>govbudget-9c2e-4f7a-connectionstrings</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.104.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
	</ItemGroup>

	<!-- Ship the user-guide documents so the in-app Guides page can serve them at runtime. -->
	<ItemGroup>
		<Content Include="docs\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="docs\images\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Include="docs\**\*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<!-- Internal security material stays in the repository; it is never deployed. -->
		<Content Remove="docs\Security_Review.md" />
	</ItemGroup>

	<!--
		Deployment conveniences:
		  - logs\.keep makes the .\logs folder exist in the publish output, so the ASP.NET Core
		    Module's stdout log folder no longer has to be created by hand on the server.
		  - App_Data is runtime state (data-protection key ring) created by the app itself and
		    must never be published, or a deployment would overwrite the live key ring and sign
		    every user out.
	-->
	<ItemGroup>
		<Content Include="logs\.keep" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
		<Content Remove="App_Data\**" />
		<None Remove="App_Data\**" />
	</ItemGroup>

</Project>
