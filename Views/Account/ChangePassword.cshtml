@{
    ViewData["Title"] = "Change password";
    var forced = ViewBag.Forced == true;
    Layout = forced ? "_LoginLayout" : "_Layout";
}

<div class="@(forced ? "container p-0" : "container py-4")" style="@(forced ? "" : "max-width:560px;")">
    @if (forced)
    {
        <div class="alert alert-warning">
            <strong>Password change required.</strong>
            An administrator issued this password, so you must set your own before continuing.
        </div>
    }
    else
    {
        <h4 class="mb-3">Change my password</h4>
    }

    <form asp-action="ChangePassword" method="post" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Current password</label>
            <input name="currentPassword" type="password" class="form-control" autocomplete="current-password" />
        </div>
        <div class="mb-3">
            <label class="form-label">New password</label>
            <input name="newPassword" type="password" class="form-control" autocomplete="new-password" />
            <div class="form-text">@ViewBag.PolicySummary</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm new password</label>
            <input name="confirmPassword" type="password" class="form-control" autocomplete="new-password" />
        </div>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Update password</button>
        </div>
    </form>

    @if (forced)
    {
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-grid mt-2">
            <button type="submit" class="btn btn-link text-muted">Sign out</button>
        </form>
    }
</div>
