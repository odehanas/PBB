@{
    ViewData["Title"] = "Reset password";
    Layout = "_LoginLayout";
}
<div class="container p-0">
    @if (ViewBag.Invalid == true)
    {
        <div class="alert alert-danger">
            This reset link is invalid or has expired. Please request a new one.
        </div>
        <div class="d-grid">
            <a asp-action="ForgotPassword" class="btn btn-outline-secondary">Request a new link</a>
        </div>
    }
    else
    {
        <h4 class="text-center mb-3 text-muted">Set a New Password</h4>
        <p class="text-center text-muted small">Account: <strong>@ViewBag.UserName</strong></p>
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" name="token" value="@ViewBag.Token" />
            <div class="mb-3">
                <label class="form-label">New password</label>
                <input name="newPassword" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-text">@ViewBag.PolicySummary</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm password</label>
                <input name="confirmPassword" type="password" class="form-control" />
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Update password</button>
            </div>
        </form>
    }
</div>
