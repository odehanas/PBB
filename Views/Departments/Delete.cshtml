@model GovBudget.Models.Departments

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this Cost Center?</h3>
<div>
    <h4>Cost Center</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Cost Center Code
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeptCode)
        </dd>
        <dt class = "col-sm-2">
            Cost Center Name
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeptName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            Entity
        </dt>
        <dd class = "col-sm-10">
            @(Model.Entity.EntityCode + " - " + Model.Entity.EntityName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="DepartmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
