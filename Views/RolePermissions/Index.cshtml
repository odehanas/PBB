@model GovBudget.Controllers.RolePermissionsController.RoleRightsVm
@{
    ViewData["Title"] = "Roles & Rights";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Roles &amp; Rights</h1>
            <div class="text-muted">Choose which forms each role can open, and what it may change on them.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">&larr; Back to Admin Room</a>
            <a asp-action="CreateRole" class="btn btn-primary">New Role</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Roles.Count == 0)
    {
        <div class="alert alert-warning mb-0">No roles are defined yet.</div>
        return;
    }

    <ul class="nav nav-tabs mb-3">
        @foreach (var r in Model.Roles)
        {
            <li class="nav-item">
                <a class="nav-link @(r.RoleId == Model.SelectedRoleId ? "active" : "")"
                   asp-action="Index" asp-route-roleId="@r.RoleId">
                    @r.RoleCode
                    @if (!r.IsActive)
                    {
                        <span class="badge bg-secondary ms-1">inactive</span>
                    }
                </a>
            </li>
        }
    </ul>

    <div class="card app-card mb-3">
        <div class="card-body py-2">
            <div class="fw-bold">@Model.SelectedRoleName <span class="text-muted">(@Model.SelectedRoleCode)</span></div>
            @if (!string.IsNullOrWhiteSpace(Model.SelectedRoleDescription))
            {
                <div class="text-muted small">@Model.SelectedRoleDescription</div>
            }
        </div>
    </div>

    @if (Model.IsSuperRole)
    {
        <div class="alert alert-info">
            <strong>SYSADMIN always has full access to every form.</strong>
            This is deliberate: because rights are edited inside the application, restricting
            SYSADMIN could lock every administrator out with no way back in. Create a separate
            role if you need a limited administrator.
        </div>
    }

    <div class="alert alert-secondary small">
        <strong>View</strong> is the master switch — without it the form cannot be opened at all.
        Ticking <strong>View</strong> on its own creates a <strong>review-only</strong> role: the user
        sees the screen and its data, but every add, edit and delete is blocked and those buttons are hidden.
    </div>

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()
        <input type="hidden" name="roleId" value="@Model.SelectedRoleId" />

        @{ var i = 0; }
        @foreach (var group in GovBudget.Utils.AppForms.Groups)
        {
            var rowsInGroup = Model.Rows.Where(r => r.Group == group).ToList();
            if (rowsInGroup.Count == 0) { continue; }

            <div class="card shadow-sm mb-3">
                <div class="card-header fw-bold">@group</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="min-width:260px;">Form</th>
                                <th class="text-center" style="width:90px;">View</th>
                                <th class="text-center" style="width:90px;">Add</th>
                                <th class="text-center" style="width:90px;">Edit</th>
                                <th class="text-center" style="width:90px;">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rowsInGroup)
                            {
                                var idx = i++;
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@row.Display</div>
                                        <div class="text-muted small">@row.Description</div>
                                        <input type="hidden" name="rows[@idx].FormKey" value="@row.FormKey" />
                                    </td>
                                    <td class="text-center">
                                        <input class="form-check-input perm-view" type="checkbox"
                                               name="rows[@idx].CanView" value="true"
                                               data-idx="@idx" @(row.CanView ? "checked" : "")
                                               @(Model.IsSuperRole ? "disabled" : "") />
                                        <input type="hidden" name="rows[@idx].CanView" value="false" />
                                    </td>
                                    @if (row.ViewOnlyByNature)
                                    {
                                        <td class="text-center text-muted small" colspan="3">
                                            read-only screen
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-center">
                                            <input class="form-check-input perm-write" type="checkbox"
                                                   name="rows[@idx].CanAdd" value="true"
                                                   data-owner="@idx" @(row.CanAdd ? "checked" : "")
                                                   @(Model.IsSuperRole ? "disabled" : "") />
                                            <input type="hidden" name="rows[@idx].CanAdd" value="false" />
                                        </td>
                                        <td class="text-center">
                                            <input class="form-check-input perm-write" type="checkbox"
                                                   name="rows[@idx].CanEdit" value="true"
                                                   data-owner="@idx" @(row.CanEdit ? "checked" : "")
                                                   @(Model.IsSuperRole ? "disabled" : "") />
                                            <input type="hidden" name="rows[@idx].CanEdit" value="false" />
                                        </td>
                                        <td class="text-center">
                                            <input class="form-check-input perm-write" type="checkbox"
                                                   name="rows[@idx].CanDelete" value="true"
                                                   data-owner="@idx" @(row.CanDelete ? "checked" : "")
                                                   @(Model.IsSuperRole ? "disabled" : "") />
                                            <input type="hidden" name="rows[@idx].CanDelete" value="false" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (!Model.IsSuperRole)
        {
            <div class="d-flex gap-2 mb-4">
                <button type="submit" class="btn btn-primary">Save Rights</button>
                <a asp-action="Index" asp-route-roleId="@Model.SelectedRoleId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script>
        // Unticking View clears the write rights on that row, matching what the server
        // enforces on save (View is the master switch).
        $(function () {
            function sync(idx) {
                var view = $('.perm-view[data-idx="' + idx + '"]').is(':checked');
                var writes = $('.perm-write[data-owner="' + idx + '"]');
                writes.prop('disabled', !view);
                if (!view) { writes.prop('checked', false); }
            }

            $('.perm-view').each(function () { sync($(this).data('idx')); });

            $(document).on('change', '.perm-view', function () {
                sync($(this).data('idx'));
            });
        });
    </script>
}
