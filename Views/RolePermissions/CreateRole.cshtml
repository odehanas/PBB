@model GovBudget.Models.AppRoles
@{
    ViewData["Title"] = "New Role";
}

<div class="container-fluid py-3" style="max-width:720px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">New Role</h1>
        <a asp-action="Index" class="btn btn-secondary">&larr; Back</a>
    </div>

    <div class="alert alert-info small">
        A new role starts with <strong>no rights at all</strong>. After creating it you will be
        taken to the rights grid to tick the forms it may use. Assign the role to users from
        <strong>Users</strong> in the Admin Room.
    </div>

    <form method="post" class="card app-card">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label">Role code</label>
                <input asp-for="RoleCode" class="form-control" placeholder="e.g. REVIEWER" maxlength="20" />
                <div class="form-text">Short upper-case code stored on the user record. Maximum 20 characters.</div>
                <span asp-validation-for="RoleCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Role name</label>
                <input asp-for="RoleName" class="form-control" placeholder="e.g. Budget Reviewer" maxlength="100" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2" maxlength="300"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="IsEntityScoped" class="form-check-input" type="checkbox" />
                <label asp-for="IsEntityScoped" class="form-check-label">Restrict to the user's own entity</label>
                <div class="form-text">
                    Recommended. Leave ticked so users with this role only ever see data for the
                    entity they are linked to.
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create Role</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
