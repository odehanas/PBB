@model List<GovBudget.Controllers.OutputEditRow>
@{
    ViewData["Title"] = "Activity Outputs";
    var year = (int)ViewBag.Year;
    var yearOptions = ViewBag.YearOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var entityOptions = ViewBag.EntityOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var selectedEntityId = ViewBag.SelectedEntityId as int?;
    var fillable = Model.Count(r => r.KpiOptions.Count > 0);
    string KpiLabel(GovBudget.Controllers.OutputKpiOption k) =>
        (k.KpiCode.Length > 0 ? k.KpiCode + " - " : "") + k.KpiName
        + (k.Target.HasValue ? " (target " + k.Target.Value.ToString("#,0.####") + ")" : " (no target)");
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Activity Outputs</h3>
        <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Back</a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select form-select-sm" asp-items="yearOptions"></select>
        </div>
        <div class="col-md-5">
            <label class="form-label">Entity</label>
            <select name="entityId" class="form-select form-select-sm" asp-items="entityOptions"></select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
        </div>
    </form>

    @if (TempData["OutputFillResult"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small" role="alert">
            @TempData["OutputFillResult"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (fillable > 0)
    {
        <form method="post" asp-action="OutputsFillFromKpis" id="fillFromKpisForm"
              class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
            <input type="hidden" name="year" value="@year" />
            <input type="hidden" name="entityId" value="@selectedEntityId" />
            <div class="small">
                <strong>@fillable</strong> empty @(fillable == 1 ? "activity has" : "activities have") an Output KPI for @year.
                Filling uses the KPI name as the measure and its target as the volume. Outputs already entered are not changed.
            </div>
            <button type="submit" class="btn btn-sm btn-success">Fill from KPIs</button>
        </form>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">No activities for this filter.</div>
            }
            else
            {
                <div class="row fw-bold text-muted small border-bottom pb-2 mb-2 d-none d-md-flex">
                    <div class="col-md-2">Programme</div>
                    <div class="col-md-4">Activity</div>
                    <div class="col-md-3">Output Measure</div>
                    <div class="col-md-2">Output Volume</div>
                    <div class="col-md-1"></div>
                </div>
                @foreach (var r in Model)
                {
                    <form method="post" asp-action="OutputSave" class="row g-2 align-items-center mb-2">
                        <input type="hidden" name="activityId" value="@r.ActivityId" />
                        <input type="hidden" name="year" value="@year" />
                        <div class="col-md-2">@r.ProgramCode</div>
                        <div class="col-md-4">@r.ActivityLabel</div>
                        <div class="col-md-3">
                            <input name="outputMeasure" value="@r.OutputMeasure" class="form-control form-control-sm" placeholder="e.g. households served" />
                        </div>
                        <div class="col-md-2">
                            <input name="outputVolume" value="@r.OutputVolume.ToString("0.####")" type="number" step="any" min="0" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                        </div>
                    </form>
                    @if (r.KpiOptions.Count == 1)
                    {
                        <div class="row mb-2">
                            <div class="col-md-6 offset-md-6 small text-muted">From KPI: @KpiLabel(r.KpiOptions[0])</div>
                        </div>
                    }
                    else if (r.KpiOptions.Count > 1)
                    {
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-md-6 offset-md-6">
                                <label class="small text-muted mb-1">This activity has @r.KpiOptions.Count Output KPIs - choose the one to fill from:</label>
                                @* Belongs to the fill form above, not to this row's save form. *@
                                <select name="pick[@r.ActivityId]" form="fillFromKpisForm" class="form-select form-select-sm">
                                    @foreach (var k in r.KpiOptions)
                                    {
                                        <option value="@k.KpiId">@KpiLabel(k)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                }
                <div class="text-muted small mt-2">Tip: clear the Output Measure and save to remove an output.</div>
            }
        </div>
    </div>
</div>
