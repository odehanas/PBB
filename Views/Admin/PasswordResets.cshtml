@model List<GovBudget.Models.PasswordResetRequests>
@{
    ViewData["Title"] = "Password Reset Requests";
    var filter = (ViewBag.FilterStatus as string) ?? "";
    var resetLink = TempData["ResetLink"] as string;
    var resetLinkUser = TempData["ResetLinkUser"] as string;
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h1 class="mb-0">Password Reset Requests</h1>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">&larr; Back to Admin Room</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!string.IsNullOrEmpty(resetLink))
    {
        <div class="card border-success mb-3">
            <div class="card-body">
                <h6 class="card-title">Reset link for <strong>@resetLinkUser</strong></h6>
                <p class="text-muted small mb-2">Copy this link and send it to the user (email/WhatsApp/Teams). It expires in 7 days and can be used once.</p>
                <div class="input-group">
                    <input type="text" id="resetLinkBox" class="form-control" value="@resetLink" readonly />
                    <button type="button" class="btn btn-outline-success" onclick="copyResetLink()">Copy</button>
                </div>
            </div>
        </div>
    }

    <div class="btn-group btn-group-sm mb-3" role="group">
        <a asp-action="PasswordResets" class="btn @(filter == "" ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="PasswordResets" asp-route-status="Pending" class="btn @(filter == "Pending" ? "btn-primary" : "btn-outline-primary")">Pending</a>
        <a asp-action="PasswordResets" asp-route-status="LinkIssued" class="btn @(filter == "LinkIssued" ? "btn-primary" : "btn-outline-primary")">Link Issued</a>
        <a asp-action="PasswordResets" asp-route-status="Completed" class="btn @(filter == "Completed" ? "btn-primary" : "btn-outline-primary")">Completed</a>
        <a asp-action="PasswordResets" asp-route-status="Rejected" class="btn @(filter == "Rejected" ? "btn-primary" : "btn-outline-primary")">Rejected</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No password reset requests.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Source</th>
                        <th>Contact</th>
                        <th>Note</th>
                        <th>Requested</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 260px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.UserName</td>
                            <td>@(r.RequestSource ?? "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ContactInfo) ? "-" : r.ContactInfo)</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Note) ? "-" : r.Note)</td>
                            <td>@r.RequestedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case "Pending":
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                    case "LinkIssued":
                                        <span class="badge bg-info text-dark">Link Issued</span>
                                        break;
                                    case "Completed":
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case "Rejected":
                                        <span class="badge bg-secondary">Rejected</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark border">@r.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                @if (r.Status == "Pending" || r.Status == "LinkIssued")
                                {
                                    <form asp-action="IssueResetLink" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ResetRequestId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            @(r.Status == "LinkIssued" ? "Regenerate Link" : "Generate Link")
                                        </button>
                                    </form>
                                    <form asp-action="RejectReset" method="post" class="d-inline" onsubmit="return confirm('Reject this request?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ResetRequestId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">No actions</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyResetLink() {
            var box = document.getElementById('resetLinkBox');
            if (!box) return;
            box.select();
            box.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(box.value).then(function () {
                // brief visual feedback
                box.classList.add('is-valid');
                setTimeout(function () { box.classList.remove('is-valid'); }, 1200);
            });
        }
    </script>
}
