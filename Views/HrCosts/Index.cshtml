@model IEnumerable<GovBudget.Models.HrEmployeeCosts>

@{
    var isBudget = ViewBag.IsBudget as bool? ?? false;
    var selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
    var selectedEntityId = ViewBag.SelectedEntityId as int?;
    var entityOptions = ViewBag.EntityOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    ViewData["Title"] = isBudget ? "HR Cost Allocation" : "HR Costs";
}

<div class="container-fluid py-3">
    @if (isBudget)
    {
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="BudgetLines" asp-action="Entry" asp-route-category="REVENUE">REVENUE</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active"
                   asp-controller="HrCosts" asp-action="Budget" asp-route-year="@selectedYear">HR</a>
            </li>
            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="BudgetLines" asp-action="Entry" asp-route-category="CAPEX">CAPEX</a>
            </li>
            <li class="nav-item">
                <a class="nav-link"
                   asp-controller="BudgetLines" asp-action="Entry" asp-route-category="OPEX">OPEX</a>
            </li>
        </ul>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">@ViewData["Title"]</h1>
            @if (isBudget)
            {
                <div class="text-muted">Allocate annual employee cost to activities and projects.</div>
            }
            else
            {
                <div class="text-muted">Imported annual cost per employee. Use Allocate per employee to assign cost to activities.</div>
            }
        </div>
        <div class="d-flex gap-2">
            @if (!isBudget)
            {
                <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">&larr; Back to Admin Room</a>
                <a asp-action="AllocationVariances" asp-route-year="@selectedYear" asp-route-q="@ViewBag.Query" asp-route-entityId="@selectedEntityId" class="btn btn-outline-warning">Allocation Variances</a>
                <a asp-action="Template" class="btn btn-outline-secondary">Download Template</a>
                <a asp-action="Export" asp-route-year="@selectedYear" asp-route-q="@ViewBag.Query" asp-route-entityId="@selectedEntityId" class="btn btn-outline-secondary">Export Excel</a>
                <a asp-action="Import" class="btn btn-primary">Import Excel</a>
            }
            else
            {
                <a asp-action="BudgetTemplate" class="btn btn-outline-secondary">Download Template</a>
                <a asp-action="BudgetExport" asp-route-year="@selectedYear" asp-route-q="@ViewBag.Query" class="btn btn-outline-secondary">Export Excel</a>
                <a asp-action="BudgetImport" class="btn btn-primary">Import Excel</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["ImportErrors"] != null)
    {
        <div class="alert alert-warning" style="white-space:pre-line;">@TempData["ImportErrors"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select" asp-items="ViewBag.BudgetYear"></select>
        </div>
        @if (!isBudget && entityOptions != null && entityOptions.Count > 1)
        {
            <div class="col-md-3">
                <label class="form-label">Entity</label>
                <select name="entityId" class="form-select" asp-items="entityOptions"></select>
            </div>
        }
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text" name="q" value="@ViewBag.Query" class="form-control" placeholder="Employee ID, name, entity, cost center" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Employee ID</th>
                    <th>Employee Name</th>
                    <th>Occupation</th>
                    <th>Entity</th>
                    <th>Cost Center</th>
                    <th class="text-end">Annual Cost</th>
                    <th class="text-end">Allocated</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                var allocated = item.HrEmployeeCostAllocations.Sum(x => x.AllocatedAmount);
                var allocationPct = item.AnnualCost <= 0m ? 0m : Math.Round((allocated / item.AnnualCost) * 100m, 2);
                var isFullyAllocated = item.AnnualCost > 0m && Math.Abs(item.AnnualCost - allocated) <= 0.01m;
                var allocationBadgeClass = isFullyAllocated ? "bg-success" : "bg-danger";
                var allocationPctText = item.AnnualCost <= 0m ? "0%" : allocationPct.ToString("0.##") + "%";
                <tr>
                    <td>@item.EmployeeId</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <span>@item.EmployeeName</span>
                            <button type="button"
                                    class="btn btn-sm btn-outline-info view-alloc-btn"
                                    data-id="@item.EmployeeCostId">
                                View Allocations
                            </button>
                        </div>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(item.Occupation) ? "-" : item.Occupation)</td>
                    <td>@item.EntityName</td>
                    <td>@item.DepartmentName</td>
                    <td class="text-end">@item.AnnualCost.ToString("N2")</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end align-items-center gap-2">
                            <span>@allocated.ToString("N2")</span>
                            <span class="badge @allocationBadgeClass">@allocationPctText</span>
                            @if (isBudget)
                            {
                                <a asp-action="Allocate" asp-route-id="@item.EmployeeCostId" asp-route-budget="true" class="btn btn-sm btn-outline-primary">Allocate</a>
                            }
                            else
                            {
                                <a asp-action="Allocate" asp-route-id="@item.EmployeeCostId" class="btn btn-sm btn-outline-primary">Allocate</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="employeeAllocationsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Employee Allocations</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="employeeAllocationsModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $(document).on('click', '.view-alloc-btn', function () {
                const id = $(this).data('id');
                const url = '@Url.Action("ViewAllocations", "HrCosts")' + '?id=' + encodeURIComponent(id);

                $('#employeeAllocationsModalBody').html('<div class="text-muted">Loading...</div>');

                const modalEl = document.getElementById('employeeAllocationsModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();

                $.get(url)
                    .done(function (html) {
                        $('#employeeAllocationsModalBody').html(html);
                    })
                    .fail(function () {
                        $('#employeeAllocationsModalBody').html('<div class="alert alert-danger mb-0">Failed to load allocations.</div>');
                    });
            });
        });
    </script>
}
