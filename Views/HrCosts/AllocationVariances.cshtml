@model IEnumerable<GovBudget.Models.AllocationVarianceRow>
@{
    ViewData["Title"] = "Allocation Variances";
    var selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
    var selectedEntityId = ViewBag.SelectedEntityId as int?;
    var entityOptions = ViewBag.EntityOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Allocation Variances</h1>
            <div class="text-muted">Employees whose total allocation does not equal their annual cost.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" asp-route-year="@selectedYear" asp-route-entityId="@selectedEntityId" class="btn btn-secondary">&larr; Back to HR Costs</a>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select" asp-items="ViewBag.BudgetYear" onchange="this.form.submit()"></select>
        </div>
        @if (entityOptions != null && entityOptions.Count > 1)
        {
            <div class="col-md-3">
                <label class="form-label">Entity</label>
                <select name="entityId" class="form-select" asp-items="entityOptions"></select>
            </div>
        }
        <div class="col-auto">
            <label class="form-label">Search</label>
            <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Employee, entity, cost center" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-success">All employees for @selectedYear are fully allocated (allocations match annual cost).</div>
    }
    else
    {
        <div class="alert alert-warning">
            @Model.Count() employee(s) need attention. Click <strong>Fix</strong> to adjust an employee's allocations directly (no SQL needed).
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Entity</th>
                        <th>Cost Center</th>
                        <th class="text-end">Annual Cost</th>
                        <th class="text-end">Allocated</th>
                        <th class="text-end">Variance</th>
                        <th class="text-end">Allocated %</th>
                        <th class="text-center">Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@r.EmployeeId</div>
                                <div class="text-muted small">@r.EmployeeName</div>
                            </td>
                            <td>@r.EntityName</td>
                            <td>@r.DepartmentName</td>
                            <td class="text-end">@r.AnnualCost.ToString("N2")</td>
                            <td class="text-end">@r.Allocated.ToString("N2")</td>
                            <td class="text-end @(r.Variance < 0m ? "text-danger" : "text-warning")">@r.Variance.ToString("N2")</td>
                            <td class="text-end">@r.AllocatedPct.ToString("0.##")%</td>
                            <td class="text-center">
                                @if (r.Status == "Over-allocated")
                                {
                                    <span class="badge bg-danger">Over-allocated</span>
                                }
                                else if (r.Status == "Unallocated")
                                {
                                    <span class="badge bg-secondary">Unallocated</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Under-allocated</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Allocate" asp-route-id="@r.EmployeeCostId" class="btn btn-sm btn-outline-primary">Fix</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
