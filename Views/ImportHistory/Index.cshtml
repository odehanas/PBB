@model GovBudget.Controllers.ImportHistoryController.ImportHistoryVm
@{
    ViewData["Title"] = "Upload History";
    var canUndo = Context.CanEdit() || Context.CanAdd() || Context.CanDelete();
    string TypeLabel(string t) => t switch
    {
        "BUDGETLINES" => "Budget lines",
        "MIDYEAR" => "Mid-year actuals",
        "HISTORICAL" => "Historical actuals",
        "ITEMS" => "Items",
        _ => t
    };
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-0">Upload History</h1>
            <div class="text-muted small">Every Excel upload that changed data. Times are UTC.</div>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Admin Room</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="white-space: pre-line;">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label small mb-1">Type</label>
            <select name="type" class="form-select form-select-sm" asp-items="Model.TypeOptions"></select>
        </div>
        <div class="col-auto">
            <label class="form-label small mb-1">Year</label>
            <input type="number" name="year" value="@Model.Year" class="form-control form-control-sm" style="width: 110px;" placeholder="Any" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm">Apply</button>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>When (UTC)</th>
                            <th>Type</th>
                            <th>Year</th>
                            <th>Entity</th>
                            <th>Scope</th>
                            <th>File</th>
                            <th>By</th>
                            <th class="text-end">Added</th>
                            <th class="text-end">Changed</th>
                            <th class="text-end">Removed</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Rows.Any())
                        {
                            <tr><td colspan="13" class="text-muted p-3">No uploads recorded yet. Uploads are logged from the moment this feature was installed.</td></tr>
                        }
                        @foreach (var r in Model.Rows)
                        {
                            var b = r.Batch;
                            <tr class="@(b.Status == "UNDONE" ? "text-muted" : "")">
                                <td>@b.ImportBatchId</td>
                                <td class="text-nowrap">@b.ImportedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-nowrap">@TypeLabel(b.ImportType)</td>
                                <td>@(b.BudgetYear?.ToString() ?? "Several")</td>
                                <td>@r.EntityCode</td>
                                <td>@b.Scope</td>
                                <td class="text-break" style="max-width: 220px;">@b.SourceFile</td>
                                <td>@b.ImportedBy</td>
                                <td class="text-end">@b.RowsCreated</td>
                                <td class="text-end">@b.RowsUpdated</td>
                                <td class="text-end">@b.RowsDeleted</td>
                                <td class="text-nowrap">
                                    @if (b.Status == "UNDONE")
                                    {
                                        <span class="badge bg-secondary" title="Undone by @b.UndoneBy at @b.UndoneAt?.ToString("yyyy-MM-dd HH:mm")">Undone</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Applied</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (canUndo && r.CanOfferUndo)
                                    {
                                        <form asp-action="Undo" method="post" class="d-inline"
                                              onsubmit="return confirm('Undo upload #@b.ImportBatchId? Added rows are removed, changed rows get their previous values back and replaced rows are put back.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.ImportBatchId" />
                                            <input type="hidden" name="type" value="@Model.Type" />
                                            <input type="hidden" name="year" value="@Model.Year" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Undo</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.PageCount > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @Model.Page of @Model.PageCount</span>
                <div class="btn-group btn-group-sm">
                    @if (Model.Page > 1)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-type="@Model.Type" asp-route-year="@Model.Year" asp-route-page="@(Model.Page - 1)">Previous</a>
                    }
                    @if (Model.Page < Model.PageCount)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-type="@Model.Type" asp-route-year="@Model.Year" asp-route-page="@(Model.Page + 1)">Next</a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="text-muted small mt-2">
        Undo is offered on the newest upload for each type, year and entity. It is refused if a later upload touched the same rows,
        if rows were edited on screen after the upload, or if the budget has been submitted. Every undo is written to the Audit Log.
    </div>
</div>
