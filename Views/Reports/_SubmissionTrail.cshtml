@model List<GovBudget.Controllers.SubmissionTrailVm>

@{
    string ActionBadge(string a) => a switch
    {
        "Submitted" => "bg-primary",
        "Returned" => "bg-warning text-dark",
        "Approved by entity" => "bg-success",
        "Approved centrally" => "bg-success",
        "Sent to central" => "bg-info text-dark",
        _ => "bg-secondary"
    };
}

<div class="card shadow-sm">
    <div class="card-header bg-white fw-bold">Approval trail</div>
    <div class="card-body p-0">
        @if (Model == null || Model.Count == 0)
        {
            <div class="p-3 text-muted">
                No dated actions recorded yet. The trail fills in as the submission is submitted,
                returned and approved.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:8%">Version</th>
                            <th style="width:18%">Action</th>
                            <th style="width:16%">When (UTC)</th>
                            <th style="width:18%">By</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="fw-bold">v@t.VersionNo</td>
                            <td><span class="badge @ActionBadge(t.Action)">@t.Action</span></td>
                            <td>@(t.At.HasValue ? t.At.Value.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                            <td>@(string.IsNullOrWhiteSpace(t.By) ? "-" : t.By)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Note) ? "" : t.Note)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
