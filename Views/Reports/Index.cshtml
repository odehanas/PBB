@model GovBudget.Controllers.ReportsIndexVm

@{
    ViewData["Title"] = "Reports";
    var report = (Model.Report ?? "income").ToLowerInvariant();
}

<style>
    /* Denser report tables so more columns/rows fit, esp. with sidebar hidden */
    .report-dense .table { font-size: .8rem; }
    .report-dense .table th, .report-dense .table td { padding: .3rem .45rem; vertical-align: middle; }
    .report-dense .table thead th { font-size: .72rem; text-transform: uppercase; letter-spacing: .02em; white-space: nowrap; }
    .report-dense .table td.text-end, .report-dense .table th.text-end { white-space: nowrap; }
    .report-dense .card-header { padding: .5rem .75rem; }
    /* Cost drill-down */
    .cost-cell { color: #0d6efd; text-decoration: underline dotted; cursor: pointer; }
    .cost-cell:hover { background-color: rgba(13,110,253,.08); }
    .detail-section.section-flash { animation: sectionFlash 1.6s ease-out; }
    @@keyframes sectionFlash {
        0% { background-color: rgba(255,193,7,.45); }
        100% { background-color: transparent; }
    }
</style>

<script>
    // Shared inline drill-down for Activity Costs and Project Costs tables.
    // rowSelector: CSS selector for clickable summary rows (must be immediately followed by a .cost-detail-row).
    // urlAction: server endpoint; idParam/idAttr: query param name and the row's data attribute holding the id.
    window.initCostDrilldown = function (rowSelector, urlAction, idParam, idAttr, year, entityId, entityAttr) {
        function scrollToSection(body, section) {
            if (!section) return;
            var target = body.querySelector('.detail-section[data-section="' + section + '"]');
            if (!target) return;
            target.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            target.classList.remove('section-flash');
            void target.offsetWidth; // restart animation
            target.classList.add('section-flash');
        }

        function ensureOpen(row, detailRow, body, caret, section) {
            if (detailRow.classList.contains('d-none')) {
                detailRow.classList.remove('d-none');
                if (caret) caret.innerHTML = '&#9662;';
            }
            if (row.getAttribute('data-loaded') === 'true') {
                scrollToSection(body, section);
                return;
            }
            if (row.getAttribute('data-loading') === 'true') return;
            row.setAttribute('data-loading', 'true');
            body.innerHTML = '<div class="p-3 text-muted small">Loading transactions&hellip;</div>';
            var rowEntity = entityAttr ? row.getAttribute(entityAttr) : '';
            var effEntity = (rowEntity && rowEntity !== '0') ? rowEntity : entityId;
            var url = urlAction + '?' + idParam + '=' + encodeURIComponent(row.getAttribute(idAttr))
                + '&year=' + encodeURIComponent(year)
                + (effEntity ? '&entityId=' + encodeURIComponent(effEntity) : '');
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (resp) {
                    if (!resp.ok) throw new Error('Failed to load (' + resp.status + ')');
                    return resp.text();
                })
                .then(function (html) {
                    body.innerHTML = html;
                    row.setAttribute('data-loaded', 'true');
                    row.setAttribute('data-loading', 'false');
                    scrollToSection(body, section);
                })
                .catch(function (err) {
                    body.innerHTML = '<div class="p-3 text-danger small">' + err.message + '</div>';
                    row.setAttribute('data-loading', 'false');
                });
        }

        document.querySelectorAll(rowSelector).forEach(function (row) {
            row.addEventListener('click', function (e) {
                var detailRow = row.nextElementSibling;
                if (!detailRow || !detailRow.classList.contains('cost-detail-row')) return;
                var body = detailRow.querySelector('.cost-detail-body');
                var caret = row.querySelector('.cost-caret');
                var cell = e.target.closest('.cost-cell');
                var section = cell ? cell.getAttribute('data-section') : null;

                if (section) {
                    // Clicking a specific amount always opens (never collapses) and scrolls to that section.
                    ensureOpen(row, detailRow, body, caret, section);
                    return;
                }
                // Clicking elsewhere on the row toggles the panel.
                if (detailRow.classList.contains('d-none')) {
                    ensureOpen(row, detailRow, body, caret, null);
                } else {
                    detailRow.classList.add('d-none');
                    if (caret) caret.innerHTML = '&#9656;';
                }
            });
        });
    };
</script>

