    <form method="get" class="row g-2 align-items-end mb-3 d-print-none">
        <input type="hidden" name="report" value="@Model.Report" />

        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select form-select-sm" asp-items="Model.YearOptions"></select>
        </div>

        @if (Model.IsAdmin)
        {
            <div class="col-md-6">
                <label class="form-label">Entity</label>
                <select name="entityId" class="form-select form-select-sm" asp-items="Model.EntityOptions"></select>
            </div>
        }

        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
        </div>

        <div class="col-auto">
            <a class="btn btn-sm btn-outline-success"
               asp-controller="Reports" asp-action="Export"
               asp-route-report="@Model.Report"
               asp-route-year="@Model.Year"
               asp-route-entityId="@(Model.EntityId?.ToString() ?? "")">
                Download Excel
            </a>
        </div>

        <div class="col-auto">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">Print</button>
        </div>

    </form>

            @if (report == "income")
            {
                if (Model.Income == null || Model.Income.Lines.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                            <span>Summary</span>
                            <span class="text-muted small fw-normal">Click a metric to drill down to its detail lines</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th class="text-end">Current</th>
                                            <th class="text-end">Forecast 1</th>
                                            <th class="text-end">Forecast 2</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="income-metric" data-filter="revenue" style="cursor: pointer;" title="Drill down to revenue lines">
                                            <td class="cost-cell">Total Revenue</td>
                                            <td class="text-end fw-bold">@Model.Income.TotalRevenue.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast1TotalRevenue.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast2TotalRevenue.ToString("N2")</td>
                                        </tr>
                                        <tr class="income-metric" data-filter="expense" style="cursor: pointer;" title="Drill down to expenditure lines (HR + CAPEX + OPEX)">
                                            <td class="cost-cell">Total Expenditures</td>
                                            <td class="text-end fw-bold">@Model.Income.TotalExpense.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast1TotalExpense.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast2TotalExpense.ToString("N2")</td>
                                        </tr>
                                        <tr class="income-metric" data-filter="all" style="cursor: pointer;" title="Drill down to all lines">
                                            <td class="cost-cell">Net</td>
                                            <td class="text-end fw-bold">@Model.Income.SurplusDeficit.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast1SurplusDeficit.ToString("N2")</td>
                                            <td class="text-end fw-bold">@Model.Income.Forecast2SurplusDeficit.ToString("N2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-2 small">
                                <span class="text-muted me-1">Expenditure breakdown:</span>
                                <span class="badge bg-light text-dark border income-metric" data-filter="HR" style="cursor: pointer;">HR: @Model.Income.TotalHr.ToString("N2")</span>
                                <span class="badge bg-light text-dark border income-metric" data-filter="CAPEX" style="cursor: pointer;">CAPEX: @Model.Income.TotalCapex.ToString("N2")</span>
                                <span class="badge bg-light text-dark border income-metric" data-filter="OPEX" style="cursor: pointer;">OPEX: @Model.Income.TotalOpex.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm d-none detail-section" id="incomeDetails" data-section="income">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Details (Program → Activity → GL) — <span id="incomeFilterLabel" class="text-primary">All</span></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="incomeShowAll">Show all</button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Program</th>
                                            <th>Activity</th>
                                            <th>GL</th>
                                            <th>GL Name</th>
                                            <th>Type</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Forecast 1</th>
                                            <th class="text-end">Forecast 2</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in Model.Income.Lines)
                                    {
                                        <tr data-cat="@r.CategoryCode">
                                            <td>@ReportLabel.CodeName(r.ProgramCode, r.ProgramName)</td>
                                            <td>@ReportLabel.CodeName(r.ActivityCode, r.ActivityName)</td>
                                            <td>@r.GLCode</td>
                                            <td>@r.GLName</td>
                                            <td>@r.CategoryCode</td>
                                            <td class="text-end">@r.Amount.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast1Amount.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast2Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <script>
                        (function () {
                            var details = document.getElementById('incomeDetails');
                            if (!details) return;
                            var labelEl = document.getElementById('incomeFilterLabel');
                            var filterMap = {
                                revenue: { cats: ['REVENUE'], label: 'Revenue' },
                                expense: { cats: ['HR', 'CAPEX', 'OPEX'], label: 'Expenditures' },
                                all: { cats: null, label: 'All' },
                                HR: { cats: ['HR'], label: 'HR' },
                                CAPEX: { cats: ['CAPEX'], label: 'CAPEX' },
                                OPEX: { cats: ['OPEX'], label: 'OPEX' }
                            };
                            function applyFilter(key) {
                                var cfg = filterMap[key] || filterMap.all;
                                details.classList.remove('d-none');
                                details.querySelectorAll('tbody tr[data-cat]').forEach(function (tr) {
                                    var cat = tr.getAttribute('data-cat');
                                    tr.style.display = (!cfg.cats || cfg.cats.indexOf(cat) >= 0) ? '' : 'none';
                                });
                                labelEl.textContent = cfg.label;
                                details.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                details.classList.remove('section-flash');
                                void details.offsetWidth;
                                details.classList.add('section-flash');
                            }
                            document.querySelectorAll('.income-metric').forEach(function (el) {
                                el.addEventListener('click', function () {
                                    applyFilter(el.getAttribute('data-filter'));
                                });
                            });
                            var showAll = document.getElementById('incomeShowAll');
                            if (showAll) showAll.addEventListener('click', function () { applyFilter('all'); });
                        })();
                    </script>
                }
            }
            else if (report == "gl")
            {
                if (Model.GlSummary == null || Model.GlSummary.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    var totalRevenue = Model.GlSummary.Sum(x => x.Revenue);
                    var totalHr = Model.GlSummary.Sum(x => x.Hr);
                    var totalCapex = Model.GlSummary.Sum(x => x.Capex);
                    var totalOpex = Model.GlSummary.Sum(x => x.Opex);
                    var totalNet = Model.GlSummary.Sum(x => x.Net);

                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">GL View</div>
                        <div class="card-body p-0">
