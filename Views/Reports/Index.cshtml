                                    {
                                        <tr class="gl-row" style="cursor: pointer;" data-gl-code="@r.GLCode" data-entity-id="@(r.EntityId > 0 ? r.EntityId : (Model.EntityId ?? 0))" data-loaded="false" title="Click to view underlying transactions">
                                            <td><span class="cost-caret text-muted me-1">&#9656;</span>@r.GLCode</td>
                                            <td>@r.GLName</td>
                                            <td class="text-end cost-cell" data-section="revenue" title="View revenue transactions">@r.Revenue.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="hr" title="View HR (imported)">@r.Hr.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="capex" title="View CAPEX transactions">@r.Capex.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="opex" title="View OPEX transactions">@r.Opex.ToString("N2")</td>
