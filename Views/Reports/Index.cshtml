                                            <th>Project</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">HR</th>
                                            <th class="text-end">CAPEX</th>
                                            <th class="text-end">OPEX</th>
                                            <th class="text-end">Total Expense</th>
                                            <th class="text-end">Net</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in Model.ProjectCosts)
                                    {
                                        <tr class="project-row" style="cursor: pointer;" data-project-id="@r.ProjectId" data-loaded="false" title="Click to view underlying transactions">
                                            <td><span class="cost-caret text-muted me-1">&#9656;</span>@ReportLabel.CodeName(r.ProjectCode, r.ProjectName)</td>
                                            <td class="text-end cost-cell" data-section="revenue" title="View revenue transactions">@r.Revenue.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="hr" title="View HR allocations">@r.Hr.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="capex" title="View CAPEX transactions">@r.Capex.ToString("N2")</td>
                                            <td class="text-end cost-cell" data-section="opex" title="View OPEX transactions">@r.Opex.ToString("N2")</td>
                                            <td class="text-end">@r.TotalExpense.ToString("N2")</td>
                                            <td class="text-end">@r.Net.ToString("N2")</td>
                                        </tr>
                                        <tr class="cost-detail-row d-none">
                                            <td colspan="7" class="p-0 bg-light">
                                                <div class="cost-detail-body"></div>
                                            </td>
                                        </tr>
