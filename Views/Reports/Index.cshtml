                    <i class="bi bi-people app-nav-icon"></i>HR Allocations (Employee)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(report == "hrrate" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index"
