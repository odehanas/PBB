                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(report == "projects" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index"
                   asp-route-report="projects" asp-route-year="@Model.Year" asp-route-entityId="@(Model.IsAdmin ? (Model.EntityId?.ToString() ?? "") : "")">
                    <i class="bi bi-folder2-open app-nav-icon"></i>Project Costs
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(report == "activities" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index"
                   asp-route-report="activities" asp-route-year="@Model.Year" asp-route-entityId="@(Model.IsAdmin ? (Model.EntityId?.ToString() ?? "") : "")">
                    <i class="bi bi-diagram-3 app-nav-icon"></i>Activity Costs
