                                    }
                                        <tr class="table-light fw-bold">
                                            <td></td>
                                            <td>Total</td>
                                            <td class="text-end">@totalRevenue.ToString("N2")</td>
                                            <td class="text-end">@totalHr.ToString("N2")</td>
                                            <td class="text-end">@totalCapex.ToString("N2")</td>
                                            <td class="text-end">@totalOpex.ToString("N2")</td>
                                            <td class="text-end">@totalNet.ToString("N2")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <script>
                        (function () {
                            var year = @Model.Year;
                            var entityId = '@(Model.EntityId?.ToString() ?? "")';
                            window.initCostDrilldown('.gl-row', '@Url.Action("GlDetail", "Reports")', 'glCode', 'data-gl-code', year, entityId, 'data-entity-id');
                        })();
                    </script>
                }
            }
            else if (report == "projects")
            {
                if (Model.ProjectCosts == null || Model.ProjectCosts.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">Project Costs</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
