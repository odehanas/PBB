                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                            <span>@(afterAlloc ? "Activity Costs (After Allocation)" : "Activity Costs")</span>
                        </div>
                        @if (afterAlloc)
                        {
                            <div class="alert alert-secondary rounded-0 border-0 border-bottom py-2 mb-0 small">
                                Costs below include the latest posted <strong>step-down allocation</strong> (Support &rarr; Mandate), spread onto each programme's activities pro-rata by their direct cost in the same category. The <strong>Allocated</strong> column is the net moved in (+) or out (&minus;). CAPEX is never reallocated. This updates automatically whenever the allocation is re-run.
                            </div>
                        }
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Program</th>
                                            <th>Activity</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">HR</th>
                                            <th class="text-end">CAPEX</th>
                                            <th class="text-end">OPEX</th>
                                            @if (afterAlloc)
                                            {
                                                <th class="text-end">Allocated</th>
                                            }
                                            <th class="text-end">Total Expense</th>
                                            <th class="text-end">Net</th>
                                            <th class="text-end">Forecast 1 Total</th>
                                            <th class="text-end">Forecast 2 Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @{
                                        var programGroups = Model.ActivityCosts
                                            .GroupBy(x => new { x.ProgramCode, x.ProgramName })
                                            .OrderBy(g => g.Key.ProgramCode);
                                    }
                                    @foreach (var g in programGroups)
                                    {
                                        var programLabel = ReportLabel.CodeName(g.Key.ProgramCode, g.Key.ProgramName, "No Program");
                                        var totalRevenue = g.Sum(x => x.Revenue);
                                        var totalHr = g.Sum(x => x.Hr);
                                        var totalCapex = g.Sum(x => x.Capex);
                                        var totalOpex = g.Sum(x => x.Opex);
                                        var totalAllocated = g.Sum(x => x.Allocated);
                                        var totalExpense = g.Sum(x => x.TotalExpense);
                                        var totalNet = g.Sum(x => x.Net);
                                        var totalF1 = g.Sum(x => x.Forecast1TotalExpense);
                                        var totalF2 = g.Sum(x => x.Forecast2TotalExpense);

                                        <tr class="table-light fw-bold">
                                            <td colspan="2">@programLabel</td>
                                            <td class="text-end">@totalRevenue.ToString("N2")</td>
                                            <td class="text-end">@totalHr.ToString("N2")</td>
                                            <td class="text-end">@totalCapex.ToString("N2")</td>
                                            <td class="text-end">@totalOpex.ToString("N2")</td>
                                            @if (afterAlloc)
                                            {
                                                <td class="text-end">@totalAllocated.ToString("N2")</td>
                                            }
                                            <td class="text-end">@totalExpense.ToString("N2")</td>
                                            <td class="text-end">@totalNet.ToString("N2")</td>
                                            <td class="text-end">@totalF1.ToString("N2")</td>
                                            <td class="text-end">@totalF2.ToString("N2")</td>
                                        </tr>

                                        foreach (var r in g.OrderBy(x => x.ActivityCode))
                                        {
                                            var clickable = r.ActivityId > 0;
                                            <tr class="@(clickable ? "activity-row" : "")" style="@(clickable ? "cursor: pointer;" : "")" data-activity-id="@r.ActivityId" data-loaded="false" title="@(clickable ? "Click to view underlying transactions" : "")">
                                                <td></td>
                                                <td>@if (clickable) { <span class="cost-caret text-muted me-1">&#9656;</span> }@ReportLabel.CodeName(r.ActivityCode, r.ActivityName)</td>
                                                <td class="text-end @(clickable ? "cost-cell" : "")" data-section="revenue">@r.Revenue.ToString("N2")</td>
                                                <td class="text-end @(clickable ? "cost-cell" : "")" data-section="hr">@r.Hr.ToString("N2")</td>
                                                <td class="text-end @(clickable ? "cost-cell" : "")" data-section="capex">@r.Capex.ToString("N2")</td>
                                                <td class="text-end @(clickable ? "cost-cell" : "")" data-section="opex">@r.Opex.ToString("N2")</td>
                                                @if (afterAlloc)
                                                {
                                                    <td class="text-end @(r.Allocated < 0 ? "text-danger" : (r.Allocated > 0 ? "text-success" : ""))">@r.Allocated.ToString("N2")</td>
                                                }
                                                <td class="text-end">@r.TotalExpense.ToString("N2")</td>
                                                <td class="text-end">@r.Net.ToString("N2")</td>
                                                <td class="text-end">@r.Forecast1TotalExpense.ToString("N2")</td>
                                                <td class="text-end">@r.Forecast2TotalExpense.ToString("N2")</td>
                                            </tr>
                                            @if (clickable)
                                            {
                                                <tr class="cost-detail-row d-none">
                                                    <td colspan="@colCount" class="p-0 bg-light">
                                                        <div class="cost-detail-body"></div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <script>
                        (function () {
                            var year = @Model.Year;
                            var entityId = '@(Model.EntityId?.ToString() ?? "")';
                            window.initCostDrilldown('.activity-row', '@Url.Action("ActivityCostDetail", "Reports")', 'activityId', 'data-activity-id', year, entityId);
                        })();
                    </script>
                }
            }
            else if (report == "hralloc")
            {
                if (Model.HrAllocations == null || Model.HrAllocations.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    var importedTotal = ViewBag.HrImportedTotal != null ? (decimal)ViewBag.HrImportedTotal : 0m;
                    var allocatedTotal = ViewBag.HrAllocatedTotal != null ? (decimal)ViewBag.HrAllocatedTotal : 0m;
                    var unallocatedTotal = ViewBag.HrUnallocatedTotal != null ? (decimal)ViewBag.HrUnallocatedTotal : 0m;

                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white fw-bold">HR Allocation Summary</div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <div class="text-muted small">Imported HR (Annual Cost)</div>
                                    <div class="fw-bold">@importedTotal.ToString("N2")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-muted small">Allocated HR</div>
                                    <div class="fw-bold">@allocatedTotal.ToString("N2")</div>
                                </div>
                                <div class="col-md-4">
                                    <div class="text-muted small">Unallocated HR</div>
                                    <div class="fw-bold">@unallocatedTotal.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">HR Allocations (Employee → Program → Activity → GL)</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Entity</th>
                                            <th>Cost Center</th>
                                            <th>Program</th>
                                            <th>Activity</th>
                                            <th>GL</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in Model.HrAllocations)
                                    {
                                        <tr>
                                            <td>@(r.EmployeeId + " - " + r.EmployeeName)</td>
                                            <td>@r.EntityName</td>
                                            <td>@r.DepartmentName</td>
                                            <td>@ReportLabel.CodeName(r.ProgramCode, r.ProgramName)</td>
                                            <td>@ReportLabel.CodeName(r.ActivityCode, r.ActivityName)</td>
                                            <td>@(string.IsNullOrWhiteSpace(r.GLName) ? r.GLCode : (r.GLCode + " - " + r.GLName))</td>
                                            <td class="text-end">@r.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (report == "hrrate")
            {
                var rate = Model.HrHourlyRates;
                if (rate == null || rate.Rows.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white fw-bold">Cost per Hour Summary</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <div class="text-muted small">Blended standard rate / hour</div>
                                    <div class="fw-bold fs-5">@(rate.BlendedRatePerHour?.ToString("N2") ?? "-")</div>
                                    <div class="text-muted" style="font-size:.72rem;">Total cost &divide; total productive hours</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-muted small">Blended nominal rate / hour</div>
                                    <div class="fw-bold fs-5 text-muted">@(rate.BlendedNominalRatePerHour?.ToString("N2") ?? "-")</div>
                                    <div class="text-muted" style="font-size:.72rem;">Reference only - do not cost with this</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="text-muted small">Employees</div>
                                    <div class="fw-bold fs-5">@((rate.EmployeeCount - rate.VacancyCount).ToString("N0"))</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="text-muted small">Vacant posts</div>
                                    <div class="fw-bold fs-5">@rate.VacancyCount.ToString("N0")</div>
                                    <div class="text-muted" style="font-size:.72rem;">Excluded from blended rate</div>
                                </div>
                                <div class="col-md-2">
                                    <div class="text-muted small">Productive hours</div>
                                    <div class="fw-bold fs-5">@rate.TotalEffectiveHours.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-secondary py-2 small d-print-none">
                        <strong>Standard rate</strong> = annual cost &divide; <strong>productive</strong> hours
                        (contracted hours less paid public holidays and annual leave).
                        Because paid leave already sits inside the annual cost, it is absorbed into the rate &mdash;
                        so hours &times; rate reconciles back to 100% of salary cost. This is the rate to use for
                        costing services, outputs and KPIs.
                        The <strong>nominal rate</strong> divides by contracted hours and understates the cost of an
                        hour actually worked; it is shown for comparison only.
                        Hours come from the work calendar in <code>core.WorkCalendars</code>.
                    </div>

                    @if (rate.MissingCalendarCount > 0)
                    {
                        <div class="alert alert-warning py-2 small">
                            <strong>@rate.MissingCalendarCount</strong> employee(s) have no work calendar for @Model.Year,
                            so no rate could be calculated. They are listed below in grey.
                            Add a calendar row for their entity (or a default row for the year) to bring them in.
                        </div>
                    }

                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">Employee Cost per Hour</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Occupation</th>
                                            <th>Entity</th>
                                            <th>Cost Center</th>
                                            <th class="text-end">Annual Cost</th>
                                            <th class="text-end">Gross Hours</th>
                                            <th class="text-end">Holiday</th>
                                            <th class="text-end">Leave</th>
                                            <th class="text-end">Effective Hours</th>
                                            <th class="text-end">Standard / hr</th>
                                            <th class="text-end">Nominal / hr</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in rate.Rows)
                                    {
                                        var muted = r.IsVacancy == true || r.IsRateAvailable != true;
                                        <tr class="@(muted ? "text-muted" : "")">
                                            <td>
                                                @(r.EmployeeId + " - " + r.EmployeeName)
                                                @if (r.IsVacancy == true)
                                                {
                                                    <span class="badge bg-secondary ms-1"
                                                          title="Budgeted vacant post: the cost is for part of a year, so an hourly rate is not meaningful.">Vacant</span>
                                                }
                                                @if (r.OverrideHours.HasValue)
                                                {
                                                    <span class="badge bg-info ms-1"
                                                          title="Hours overridden for this employee instead of using the entity calendar.">Override</span>
                                                }
                                                @if (r.IsRateAvailable != true)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1"
                                                          title="No work calendar found for this budget year.">No calendar</span>
                                                }
                                            </td>
                                            <td>@r.Occupation</td>
                                            <td>@r.EntityName</td>
                                            <td>@r.DepartmentName</td>
                                            <td class="text-end">@r.AnnualCost.ToString("N2")</td>
                                            <td class="text-end">@(r.GrossPaidHours?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(r.HolidayHours?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(r.LeaveHours?.ToString("N0") ?? "-")</td>
                                            <td class="text-end">@(r.EffectiveHours?.ToString("N0") ?? "-")</td>
                                            <td class="text-end fw-bold">@(r.StandardRatePerHour?.ToString("N2") ?? "-")</td>
                                            <td class="text-end text-muted">@(r.NominalRatePerHour?.ToString("N2") ?? "-")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (report == "entitysummary")
            {
                if (Model.EntitySummary == null || Model.EntitySummary.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">Entity Budget Summary</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Entity</th>
                                            <th class="text-end">Revenue</th>
                                            <th class="text-end">HR Cost</th>
                                            <th class="text-end">Head Count</th>
                                            <th class="text-end">CAPEX</th>
                                            <th class="text-end">OPEX</th>
                                            <th class="text-end">Total Expense</th>
                                            <th class="text-end">Net</th>
                                            <th class="text-end">Forecast 1 Revenue</th>
                                            <th class="text-end">Forecast 1 Total Expense</th>
                                            <th class="text-end">Forecast 1 Net</th>
                                            <th class="text-end">Forecast 2 Revenue</th>
                                            <th class="text-end">Forecast 2 Total Expense</th>
                                            <th class="text-end">Forecast 2 Net</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in Model.EntitySummary)
                                    {
                                        <tr>
                                            <td>@(r.EntityCode + " - " + r.EntityName)</td>
                                            <td class="text-end">@r.Revenue.ToString("N2")</td>
                                            <td class="text-end">@r.HrCost.ToString("N2")</td>
                                            <td class="text-end">@r.HeadCount.ToString("N0")</td>
                                            <td class="text-end">@r.Capex.ToString("N2")</td>
                                            <td class="text-end">@r.Opex.ToString("N2")</td>
                                            <td class="text-end">@r.TotalExpense.ToString("N2")</td>
                                            <td class="text-end">@r.Net.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast1Revenue.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast1TotalExpense.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast1Net.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast2Revenue.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast2TotalExpense.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast2Net.ToString("N2")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (report == "trend")
            {
                if (Model.TrendSummary == null || Model.TrendSummary.Count == 0)
                {
                    <div class="alert alert-info">No data found for the selected filters.</div>
                }
                else
                {
                    var y = Model.Year;

                    <div class="card shadow-sm">
                        <div class="card-header bg-white fw-bold">Trend Summary (Actuals + Budget + Forecasts)</div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-striped table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Line</th>
                                            <th class="text-end">@((y - 1).ToString()) Actual</th>
                                            <th class="text-end">@y Budget</th>
                                            <th class="text-end">@((y + 1).ToString()) Forecast</th>
                                            <th class="text-end">@((y + 2).ToString()) Forecast</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var r in Model.TrendSummary)
                                    {
                                        <tr>
                                            <td>@r.Line</td>
                                            <td class="text-end">@r.Actual.ToString("N2")</td>
                                            <td class="text-end">@r.Budget.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast1.ToString("N2")</td>
                                            <td class="text-end">@r.Forecast2.ToString("N2")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
</div>
