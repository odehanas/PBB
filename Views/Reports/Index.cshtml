                   asp-controller="Reports" asp-action="Index"
                   asp-route-report="activitiesalloc" asp-route-year="@Model.Year" asp-route-entityId="@(Model.IsAdmin ? (Model.EntityId?.ToString() ?? "") : "")">
                    <i class="bi bi-diagram-3-fill app-nav-icon"></i>Activity Costs (After Allocation)
