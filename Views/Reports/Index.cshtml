                    <script>
                        (function () {
                            var year = @Model.Year;
                            var entityId = '@(Model.EntityId?.ToString() ?? "")';
                            window.initCostDrilldown('.project-row', '@Url.Action("ProjectCostDetail", "Reports")', 'projectId', 'data-project-id', year, entityId);
                        })();
