@model GovBudget.Controllers.MidYearController.MidYearIndexVm

@{
    ViewData["Title"] = "Mid-Year Forecast";
    var rows = Model?.Rows ?? new List<GovBudget.Controllers.MidYearController.MidYearRowVm>();
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h1 class="mb-0">Mid-Year Forecast</h1>
            <div class="text-muted small">Budget @Model.Year — @Model.EntityLabel · Actuals &amp; forecast for @Model.ActualYear</div>
        </div>
        <a asp-controller="Context" asp-action="Select" asp-route-returnUrl="@Url.Action("Index","MidYear", new { year = Model.Year })" class="btn btn-outline-secondary btn-sm">Change Context</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" style="white-space: pre-line;">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Upload @Model.ActualYear Actuals &amp; H2 Forecast</div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-action="Template" class="btn btn-outline-secondary btn-sm">Download Template</a>
                @if (Context.CanAdd())
                {
                    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex flex-wrap align-items-center gap-2 mb-0">
                        @Html.AntiForgeryToken()
                        <input type="file" name="file" accept=".xlsx" class="form-control form-control-sm" style="max-width: 320px;" required />
                        <button type="submit" class="btn btn-success btn-sm">Upload</button>
                    </form>
                }
            </div>
            <div class="text-muted small mt-2">
                Columns: BudgetYear (@Model.ActualYear), EntityCode, GLCode, GLType (Revenue/HR/Opex/Capex), ActualH1Amount, ForecastH2Amount (optional).
                The template is pre-filled with the rows already loaded for this entity. A blank H2 cell keeps the existing forecast.
            </div>
        </div>
    </div>

    @if (!rows.Any())
    {
        <div class="alert alert-info mb-0">
            No mid-year actuals for @Model.ActualYear have been uploaded for this entity yet.
            @if (Model.ContextYearHasActuals)
            {
                <div class="mt-1">
                    @Model.Year actuals are loaded — they are reviewed while preparing budget year <strong>@(Model.Year + 1)</strong>.
                    Use <em>Change Context</em> and choose @(Model.Year + 1).
                </div>
            }
        </div>
    }
    else
    {
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Year" value="@Model.Year" />

            <div class="card shadow-sm">
                <div class="card-header bg-white fw-bold">@Model.ActualYear H1 Actuals + H2 Forecast</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>GL Type</th>
                                    <th>GL</th>
                                    <th class="text-end">Actual (H1)</th>
                                    <th class="text-end">Forecast (H2)</th>
                                    <th class="text-end">Estimated Full Year</th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (var i = 0; i < rows.Count; i++)
                            {
                                var r = rows[i];
                                var forecast = r.ForecastH2Amount ?? 0m;
                                <tr>
                                    <td class="text-nowrap">@r.GLType</td>
                                    <td class="text-nowrap">@r.GLCode</td>
                                    <td class="text-end">@r.ActualH1Amount.ToString("#,##0.00")</td>
                                    <td class="text-end" style="min-width: 180px;">
                                        <input type="hidden" name="Rows[@i].MidYearId" value="@r.MidYearId" />
                                        <input type="number" step="0.01" class="form-control form-control-sm text-end" name="Rows[@i].ForecastH2Amount" value="@(r.ForecastH2Amount?.ToString() ?? "")" placeholder="Enter H2 forecast" />
                                    </td>
                                    <td class="text-end">@((r.ActualH1Amount + forecast).ToString("#,##0.00"))</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-white d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Save Forecast</button>
                </div>
            </div>
        </form>
    }
</div>
