@model GovBudget.Controllers.ItemImportConfirmVm

@{
    ViewData["Title"] = "Confirm Item Import";
}

<h1>Confirm Item Import</h1>

<div class="alert alert-warning">
    <strong>@Model.Conflicts.Count</strong> item code(s) in your file already exist in the database.
    Confirming will <strong>overwrite</strong> those items (name, GL account and active status) with the
    values from your file.
    @if (Model.NewCount > 0)
    {
        <text> <strong>@Model.NewCount</strong> new item(s) will also be added.</text>
    }
    Existing items that are <strong>not</strong> in your file will be kept unchanged.
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">Items that will be overwritten</div>
    <div class="table-responsive">
        <table class="table table-sm table-striped mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>Item Code</th>
                    <th>Existing Name</th>
                    <th>New Name (from file)</th>
                    <th>New GL Code</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var c in Model.Conflicts)
            {
                <tr>
                    <td>@c.ItemCode</td>
                    <td>@c.ExistingName</td>
                    <td class="@(string.Equals(c.ExistingName, c.NewName, StringComparison.Ordinal) ? "" : "fw-bold text-primary")">@c.NewName</td>
                    <td>@c.NewGLCode</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex gap-2">
    <form asp-action="ConfirmUpload" method="post" class="d-inline"
          onsubmit="return confirm('Overwrite @Model.Conflicts.Count existing item(s)? This cannot be undone.');">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Overwrite existing items</button>
    </form>
    <form asp-action="CancelUpload" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary">Cancel — keep existing items</button>
    </form>
</div>
