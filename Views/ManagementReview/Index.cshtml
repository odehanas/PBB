    </div>

    <h2 class="pbb-h2">Unit Economics &amp; Value</h2>

    @* ---------- Activity Unit Cost & Actuals ---------- *@
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
            <span>Activity Cost, Actuals &amp; Variance</span>
            <span class="d-flex gap-2">
                @if (Model.AllocationPosted)
                {
                    <span class="badge bg-success">After allocation</span>
                }
                else
                {
                    <span class="badge bg-secondary">Direct cost only</span>
                }
                @if (!Model.ActualsUploaded)
                {
                    <span class="badge bg-warning text-dark">Actuals not uploaded</span>
                }
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.ActivityUnitCosts.Count == 0)
            {
                <div class="alert alert-info m-3">No activity cost data for the selected filters.</div>
            }
            else
            {
                @if (Model.AllocationPosted)
                {
                    <div class="alert alert-success m-3 mb-0 py-2 small">
                        <strong>Costs shown are after step-down allocation.</strong> <em>Total</em> = <em>Direct</em> + <em>Allocated</em>,
                        where <em>Allocated</em> is the activity's share of its programme's net allocation (positive for Mandate programmes,
                        negative for Support programmes whose cost is swept out). Cost / Output uses the <strong>Total</strong>.
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary m-3 mb-0 py-2 small">
                        <strong>These are direct activity costs only &mdash; no allocated cost is attached.</strong>
                        No step-down allocation has been posted for this year/scope, so <em>Allocated</em> is zero and <em>Total</em> equals <em>Direct</em>.
                        Run it from <a asp-controller="Allocation" asp-action="Index" asp-route-year="@Model.Year" asp-route-entityId="@Model.EntityId">Cost Allocation</a> to distribute support-programme costs.
                    </div>
                }
                @if (!Model.ActualsUploaded)
                {
                    <div class="alert alert-warning m-3 mb-0 py-2 small">
                        <strong>Actuals have not been uploaded</strong> for this year and scope, so Actual and Variance are blank.
                        Import current-year actuals from <a asp-controller="Actuals" asp-action="Index" asp-route-year="@Model.Year" asp-route-entityId="@Model.EntityId">Import Actuals</a> to populate them.
                    </div>
                }
                else
                {
                    <div class="px-3 pt-2 text-muted small">Actuals are derived from posted GL actuals, split across activities by budget share. Variance = Actual &minus; Direct budget.</div>
                }
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Entity</th>
                                <th>Programme</th>
                                <th>Activity</th>
                                <th class="text-end">Direct</th>
                                <th class="text-end">Allocated</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Actual</th>
                                <th class="text-end">Variance</th>
                                <th>Output Measure</th>
                                <th class="text-end">Output Volume</th>
                                <th class="text-end">Cost / Output</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var x in Model.ActivityUnitCosts)
                        {
                            <tr>
                                <td>@x.EntityCode</td>
                                <td>@x.ProgramCode</td>
                                <td>@x.ActivityCode - @x.ActivityName</td>
                                <td class="text-end">@x.AnnualCost.ToString("N2")</td>
                                <td class="text-end @(x.AllocatedCost < 0 ? "text-danger" : (x.AllocatedCost > 0 ? "text-success" : "text-muted"))">
                                    @(x.AllocatedCost != 0 ? x.AllocatedCost.ToString("N2") : "—")
                                </td>
                                <td class="text-end fw-bold">@x.TotalCost.ToString("N2")</td>
                                <td class="text-end">@(x.ActualCost.HasValue ? x.ActualCost.Value.ToString("N2") : "—")</td>
                                <td class="text-end fw-bold @(x.Variance.HasValue ? (x.Variance.Value > 0 ? "text-danger" : "text-success") : "")">
                                    @(x.Variance.HasValue ? x.Variance.Value.ToString("N2") : "—")
                                </td>
                                <td>@x.OutputMeasure</td>
                                <td class="text-end">@(x.OutputVolume > 0 ? x.OutputVolume.ToString("N2") : "")</td>
                                <td class="text-end fw-bold">@(x.CostPerOutput > 0 ? x.CostPerOutput.ToString("N2") : "")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---------- Cost per KPI (activity cost -> all linked KPIs, weighted) ---------- *@
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
            <span>Cost per KPI (all activity-linked KPIs)</span>
            @if (!Model.ActualsUploaded)
            {
                <span class="badge bg-warning text-dark">Actuals not uploaded</span>
            }
        </div>
        <div class="card-body p-0">
            @if (Model.CostPerOutput.Count == 0)
            {
                <div class="alert alert-info m-3 mb-0">
                    No KPIs linked to activities for this scope. Link a KPI to an <em>activity</em> (any Type) to
                    distribute that activity's cost across its KPIs by <strong>Cost Weight</strong>.
                </div>
            }
            else
            {
                <div class="px-3 pt-2 text-muted small">
                    Each activity's <strong>after-allocation</strong> cost (Direct + step-down Allocated@(Model.AllocationPosted ? "" : "; no allocation posted yet, so this equals Direct"))
                    is distributed across <strong>all</strong> its KPIs (Input / Output / Outcome),
                    weighted by each KPI's <strong>Cost Weight</strong> (equal split when no weights are set). Non-output KPIs
                    now carry cost so management can see and decide on cost not tied to outputs.
                    Cost / Planned = allocated budget &divide; target; Cost / Actual = allocated actual &divide; achieved.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Entity</th>
                                <th>Programme</th>
                                <th>Activity</th>
                                <th>KPI</th>
                                <th>Type</th>
                                <th class="text-end">Weight</th>
                                <th class="text-end">Alloc. Budget</th>
                                <th class="text-end">Alloc. Actual</th>
                                <th class="text-end">Target</th>
                                <th class="text-end">Actual</th>
                                <th class="text-end">Cost / Planned</th>
                                <th class="text-end">Cost / Actual</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var x in Model.CostPerOutput)
                        {
                            <tr>
                                <td>@x.EntityCode</td>
                                <td>@x.ProgramCode</td>
                                <td>@x.ActivityLabel</td>
                                <td dir="auto">
                                    @x.KpiName
                                    @if (x.OutputKpiCount > 1)
                                    {
                                        <span class="text-muted" style="font-size:.7rem;"> (1 of @x.OutputKpiCount)</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(x.KpiType))
                                    {
                                        <span class="badge @(x.KpiType.Equals("Output", StringComparison.OrdinalIgnoreCase) ? "bg-success" : x.KpiType.Equals("Outcome", StringComparison.OrdinalIgnoreCase) ? "bg-info text-dark" : "bg-secondary")" style="font-size:.62rem;">@x.KpiType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">@(x.CostWeight > 0 ? x.CostWeight.ToString("0.##") : "—")</td>
                                <td class="text-end">@x.AllocatedBudget.ToString("N2")</td>
                                <td class="text-end">@(x.AllocatedActual.HasValue ? x.AllocatedActual.Value.ToString("N2") : "—")</td>
                                <td class="text-end">@(x.OutputTarget.HasValue ? x.OutputTarget.Value.ToString("N2") : "—")</td>
                                <td class="text-end">@(x.OutputActual.HasValue ? x.OutputActual.Value.ToString("N2") : "—")</td>
                                <td class="text-end fw-bold">@(x.CostPerPlannedOutput.HasValue ? x.CostPerPlannedOutput.Value.ToString("N2") : "—")</td>
                                <td class="text-end fw-bold">@(x.CostPerActualOutput.HasValue ? x.CostPerActualOutput.Value.ToString("N2") : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---------- KPI <-> Cost Linkage ---------- *@
    @if (Model.KpiCostLinks.Count > 0)
    {
        <div class="card shadow-sm mb-3 pbb-long">
            <div class="card-header bg-white fw-bold">KPI &#8596; Cost Linkage (Cost per Unit of Improvement)</div>
            <div class="card-body p-0">
                @foreach (var g in Model.KpiCostLinks.GroupBy(x => new { x.EntityCode, x.EntityName }))
                {
                    <div class="kl-entity">@g.Key.EntityCode@(string.IsNullOrWhiteSpace(g.Key.EntityName) ? "" : " — " + g.Key.EntityName)</div>
                    @foreach (var x in g)
                    {
                        <div class="kpilink">
                            <div class="kl-top">
                                <div class="kl-name" dir="auto">
                                    @x.KpiName@(string.IsNullOrEmpty(x.Unit) ? "" : $" ({x.Unit})")
                                </div>
                                <span class="badge @(x.Status == "Green" ? "bg-success" : x.Status == "Watch" ? "bg-warning text-dark" : x.Status == "Behind" ? "bg-danger" : "bg-secondary")">
                                    @(string.IsNullOrEmpty(x.Status) ? "n/a" : x.Status)
                                </span>
                            </div>
                            <div class="kl-driver" dir="auto">
                                <span class="badge @(x.LinkLevel == "Activity" ? "bg-info text-dark" : x.LinkLevel == "Programme" ? "bg-primary" : "bg-secondary")">@x.LinkLevel</span>
                                @(string.IsNullOrWhiteSpace(x.LinkLabel) ? "No linked cost driver" : x.LinkLabel)
                            </div>
                            <div class="kl-metrics">
                                <div class="m"><span class="m-l">Linked Cost</span><span class="m-v">@(x.LinkedCost.HasValue ? x.LinkedCost.Value.ToString("N0") : "—")</span></div>
                                <div class="m"><span class="m-l">Baseline</span><span class="m-v">@(x.Baseline?.ToString("N2") ?? "—")</span></div>
                                <div class="m"><span class="m-l">Actual</span><span class="m-v">@(x.Actual?.ToString("N2") ?? "—")</span></div>
                                <div class="m"><span class="m-l">Improvement</span><span class="m-v">@(x.Improvement?.ToString("N2") ?? "—")</span></div>
                                <div class="m accent"><span class="m-l">Cost / Improvement</span><span class="m-v">@(x.CostPerImprovement.HasValue ? x.CostPerImprovement.Value.ToString("N0") : "—")</span></div>
                            </div>
                        </div>
                    }
                }
                <div class="text-muted small p-2">Cost is taken from the KPI's tagged activity (preferred) or programme. Improvement is direction-aware; cost-per-improvement is shown only when improvement is positive.</div>
            </div>
        </div>
    }

    @* ---------- Entity Profiles ---------- *@
    @if (Model.EntityProfiles.Count > 0)
    {
        <h2 class="pbb-h2">Entity Profiles</h2>
        @foreach (var p in Model.EntityProfiles)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@p.EntityCode - @p.EntityName</span>
                    @if (!string.IsNullOrEmpty(p.StatusLabel))
                    {
                        <span class="badge @(p.StatusLabel.ToUpper() == "AHEAD" ? "bg-success" : p.StatusLabel.ToUpper() == "BEHIND" ? "bg-danger" : "bg-warning text-dark")">@p.StatusLabel</span>
                    }
                </div>
                <div class="card-body">
                    <div class="row text-center mb-3">
                        <div class="col"><div class="text-muted small">Maturity</div><div class="fs-4 fw-bold">@(p.Stage?.ToString("0.0") ?? "-")<span class="fs-6 text-muted"> / 4.0</span></div><div class="small">@p.Form</div></div>
                        <div class="col"><div class="text-muted small">Budget</div><div class="fs-4 fw-bold">@p.Budget.ToString("N0")</div><div class="small">AED</div></div>
                        <div class="col"><div class="text-muted small">FTE</div><div class="fs-4 fw-bold">@p.HeadCount</div><div class="small">headcount</div></div>
                        <div class="col"><div class="text-muted small">KPIs Green</div><div class="fs-4 fw-bold">@p.PctGreen.ToString("N0")%</div><div class="small">@p.KpiGreen of @p.KpiTotal</div></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(p.Assessment))
                    {
                        <div class="mb-2">
                            <div class="fw-bold small text-uppercase text-muted">Performance Assessment</div>
                            <div style="white-space: pre-line;">@p.Assessment</div>
                        </div>
                    }
                    <div class="row">
                        @if (p.Outcomes.Count > 0)
                        {
                            <div class="col-md-6">
                                <div class="fw-bold small text-uppercase text-muted">Key Outcomes — Mid-Year</div>
                                <ul class="mb-0">@foreach (var o in p.Outcomes){<li>@o</li>}</ul>
                            </div>
                        }
                        @if (p.Issues.Count > 0)
                        {
                            <div class="col-md-6">
                                <div class="fw-bold small text-uppercase text-danger">Performance Issues — Mid-Year</div>
                                <ul class="mb-0">@foreach (var iss in p.Issues){<li>@iss</li>}</ul>
                            </div>
                        }
                    </div>
                    @if (string.IsNullOrWhiteSpace(p.Assessment) && p.Outcomes.Count == 0 && p.Issues.Count == 0)
                    {
                        <div class="text-muted small">No narrative yet. Add it under <a asp-controller="Performance" asp-action="ReviewNotes" asp-route-entityId="">Performance &gt; Entity Profiles</a>.</div>
                    }
                </div>
            </div>
        }
    }

    <h2 class="pbb-h2">Executive Decisions</h2>

    @* ---------- Headline Findings ---------- *@
    @if (Model.Narratives.Findings.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-bold">Headline Findings</div>
            <div class="card-body">
                <ol class="mb-0">
                @foreach (var f in Model.Narratives.Findings)
                {
                    <li class="mb-2"><span class="fw-bold">@f.Title</span>@if (!string.IsNullOrWhiteSpace(f.Body)){<div>@f.Body</div>}</li>
                }
                </ol>
            </div>
        </div>
    }

    @* ---------- Recommendations ---------- *@
    @if (Model.Narratives.Recommendations.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-bold">Recommendations — Executive Decisions</div>
            <div class="card-body">
                <ol class="mb-0">
                @foreach (var rec in Model.Narratives.Recommendations)
                {
                    <li class="mb-2"><span class="fw-bold">@rec.Title</span>@if (!string.IsNullOrWhiteSpace(rec.Body)){<div>@rec.Body</div>}</li>
                }
                </ol>
            </div>
        </div>
    }

    @* ---------- 90-Day Plan ---------- *@
    @if (Model.Narratives.Actions.Count > 0)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white fw-bold">90-Day Plan</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr><th>Action</th><th>Owner</th><th>Due</th><th>Success Measure</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var a in Model.Narratives.Actions)
                        {
                            <tr>
                                <td>@a.Title</td>
                                <td>@a.Owner</td>
                                <td>@a.DueText</td>
                                <td>@a.SuccessMeasure</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <h2 class="pbb-h2">Governance</h2>

    @* ---------- Governance (static framework) ---------- *@
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white fw-bold">Governance Framework</div>
        <div class="card-body">
            <p class="text-muted small mb-2">Six actors with clear, separated decision rights across the PBB cycle. Aligned with OECD GOV/SBO(2023)1 and PEFA 2016 separation principles.</p>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-2">
                    <thead class="table-light">
                        <tr><th>Actor</th><th>Goal Setting (Annual)</th><th>Monitoring (Monthly/Quarterly)</th><th>Updating (Mid-year + Annual)</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Oversight Body</td><td>A — Approves priorities, envelopes, outcome targets</td><td>A — Receives quarterly reports; approves &gt;threshold reallocations</td><td>A — Approves rebaselining + major reallocations</td></tr>
                        <tr><td>Department of Finance</td><td>R — Issues circular, sets caps, validates KPI quality</td><td>R — Consolidated performance reports</td><td>R — Technical analysis; updates cost benchmarks</td></tr>
                        <tr><td>Audit Committee</td><td>I — Advises on KPI methodology</td><td>R — Independent performance audits; quarterly findings</td><td>C — Validates updates; flags governance concerns</td></tr>
                        <tr><td>Line Departments</td><td>R — Design programmes; set KPIs</td><td>R — Monthly dashboards; variance explanations</td><td>R — Propose adjustments; lessons learned</td></tr>
                        <tr><td>Human Resources</td><td>C — FTE planning + compensation inputs</td><td>R — Manpower utilisation tracking</td><td>C — Revises FTE plans + compensation forecasts</td></tr>
                        <tr><td>Information Technology</td><td>C — IT capex + integration roadmap inputs</td><td>R — FMIS data quality + availability</td><td>C — Revises capex schedules + integration roadmap</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="small text-muted">R = Responsible · A = Accountable · C = Consulted · I = Informed</div>
            <hr />
            <div class="fw-bold small text-uppercase text-muted mb-1">Cadence</div>
            <ul class="mb-0 small">
                <li><span class="fw-bold">Real-time</span> — FMIS performance + data quality monitoring (IT)</li>
