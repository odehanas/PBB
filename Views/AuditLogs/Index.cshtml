@model IEnumerable<GovBudget.Models.AuditLogs>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container py-3">
    <h1 class="mb-4">Audit Logs</h1>
    <p class="text-muted">Showing the latest 500 records.</p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Record ID</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="white-space:nowrap;">@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@item.UserName</td>
                        <td>
                            @if(item.Action == "LOGIN") {
                                <span class="badge bg-success">LOGIN</span>
                            }
                            else if(item.Action == "INSERT") {
                                <span class="badge bg-primary">INSERT</span>
                            }
                            else if(item.Action == "UPDATE") {
                                <span class="badge bg-warning text-dark">UPDATE</span>
                            }
                            else if(item.Action == "DELETE") {
                                <span class="badge bg-danger">DELETE</span>
                            }
                            else {
                                <span class="badge bg-secondary">@item.Action</span>
                            }
                        </td>
                        <td>@item.EntityName</td>
                        <td>@item.RecordId</td>
                        <td>@item.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-3">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Back to Admin Room</a>
    </div>
</div>
