@model IEnumerable<GovBudget.Models.WorkCalendars>

@{
    ViewData["Title"] = "Work Calendars";
    var selectedYear = ViewBag.SelectedYear as int? ?? DateTime.Now.Year;
    var isGlobalAdmin = ViewBag.IsGlobalAdmin as bool? ?? false;
    var coverage = ViewBag.CoverageByEntity as Dictionary<int, int> ?? new Dictionary<int, int>();
    var defaultCoverage = ViewBag.DefaultCoverage as int? ?? 0;
    var totalEmployees = ViewBag.TotalEmployees as int? ?? 0;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">Work Calendars</h1>
            <div class="text-muted">
                Working-time variables used to turn each employee's annual cost into a cost per hour.
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">&larr; Back to Admin Room</a>
            <a asp-controller="Reports" asp-action="Index" asp-route-report="hrrate" asp-route-year="@selectedYear"
               class="btn btn-outline-info">View Cost per Hour</a>
            <a asp-action="Create" asp-route-year="@selectedYear" class="btn btn-primary">Add Calendar</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="alert alert-secondary py-2 small">
        The standard hourly rate divides annual cost by <strong>productive</strong> hours &mdash; contracted hours
        less paid public holidays and annual leave. Paid leave is already inside the annual salary, so absorbing it
        into the rate is what makes hours &times; rate add back up to 100% of salary cost.
        Editing a calendar changes the reported rate <strong>immediately</strong>; there is nothing to recalculate
        and no deployment needed.
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label">Year</label>
            <select name="year" class="form-select" asp-items="ViewBag.YearOptions"></select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Show</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            No calendar exists for @selectedYear, so no hourly rate can be produced for any of the
            @totalEmployees.ToString("N0") employee(s) in that year.
            <a asp-action="Create" asp-route-year="@selectedYear">Add one</a> to switch the report on.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Scope</th>
                        <th>Calendar</th>
                        <th class="text-end">Hours/Day</th>
                        <th class="text-end">Days/Week</th>
                        <th class="text-end">Weeks</th>
                        <th class="text-end">Holidays</th>
                        <th class="text-end">Leave</th>
                        <th class="text-end">Gross Hours</th>
                        <th class="text-end">Productive Hours</th>
                        <th class="text-end">Employees</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    var isDefault = !c.EntityId.HasValue;
                    var covered = isDefault
                        ? defaultCoverage
                        : (coverage.TryGetValue(c.EntityId!.Value, out var n) ? n : 0);
                    <tr class="@(c.IsActive ? "" : "text-muted")">
                        <td>
                            @if (isDefault)
                            {
                                <span class="badge bg-primary">All entities</span>
                            }
                            else
                            {
                                @(c.Entity != null ? c.Entity.EntityCode + " - " + c.Entity.EntityName : "Entity " + c.EntityId)
                            }
                            @if (!c.IsActive)
                            {
                                <span class="badge bg-secondary ms-1">Inactive</span>
                            }
                        </td>
                        <td>@c.CalendarName</td>
                        <td class="text-end">@c.HoursPerDay.ToString("0.##")</td>
                        <td class="text-end">@c.WorkDaysPerWeek.ToString("0.##")</td>
                        <td class="text-end">@c.WeeksPerYear.ToString("0.##")</td>
                        <td class="text-end">@c.PublicHolidayDays.ToString("0.##")</td>
                        <td class="text-end">@c.AnnualLeaveDays.ToString("0.##")</td>
                        <td class="text-end text-muted">@c.GrossPaidHours.ToString("N0")</td>
                        <td class="text-end fw-bold">@c.ProductiveHours.ToString("N0")</td>
                        <td class="text-end">@covered.ToString("N0")</td>
                        <td class="text-end">
                            @if (isGlobalAdmin || c.EntityId.HasValue)
                            {
                                <a asp-action="Edit" asp-route-id="@c.CalendarId" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@c.CalendarId" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="text-muted small">
            An entity uses its own calendar when it has one, and the <span class="badge bg-primary">All entities</span>
            default otherwise. The Employees column shows how many people each row currently drives, so you can see
            what an edit will move before you make it.
        </div>
    }
</div>
