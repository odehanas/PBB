@model GovBudget.Models.Activities

@{
    ViewData["Title"] = "Delete Activity";
    var dependencies = ViewBag.Dependencies as List<string> ?? new List<string>();
    var canDelete = ViewBag.CanDelete == null ? true : (bool)ViewBag.CanDelete;
}

<h1>Delete Activity</h1>

@if (!canDelete)
{
    <div class="alert alert-warning">
        <h5 class="alert-heading">This activity cannot be deleted</h5>
        <p class="mb-2">It is already used by the following records, and deleting it would remove financial history:</p>
        <ul class="mb-2">
            @foreach (var d in dependencies)
            {
                <li>@d</li>
            }
        </ul>
        <p class="mb-0">
            Reassign or remove those records first, or use <strong>Mark inactive</strong> below to hide the activity
            from new entries while keeping its history intact.
        </p>
    </div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
}

<div>
    <h4>Activity</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ActivityCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ActivityCode)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ActivityName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ActivityName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsActive)
        </dd>
        <dt class = "col-sm-2">
            Cost Center
        </dt>
        <dd class = "col-sm-10">
            @(Model.Department != null ? $"{Model.Department.DeptCode} - {Model.Department.DeptName}" : "-")
        </dd>
        <dt class = "col-sm-2">
            Program
        </dt>
        <dd class = "col-sm-10">
            @(Model.Program != null ? $"{Model.Program.ProgramCode} - {Model.Program.ProgramName}" : "-")
        </dd>
    </dl>

    <div class="d-flex align-items-center gap-2">
        @if (canDelete)
        {
            <form asp-action="Delete" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ActivityId" />
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        }
        @if (Model.IsActive)
        {
            <form asp-action="Deactivate" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ActivityId" />
                <button type="submit" class="btn btn-outline-secondary">Mark inactive</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </div>
</div>
