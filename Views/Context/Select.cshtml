@model IEnumerable<GovBudget.Models.Entities>

@{
    ViewData["Title"] = "Budget Setup - Select Context";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2>Budget Setup <small class="text-muted fs-5">Select Entity and Cost Center</small></h2>
            <p class="text-secondary">Please select the Budget Year, then choose a Cost Center within your Entity to proceed with budget entry.</p>
        </div>
    </div>

    <!-- Hidden Form for Submission -->
    <form id="selectContextForm" asp-action="Select" method="post">
        <input type="hidden" name="EntityId" id="hEntityId" />
        <input type="hidden" name="DepartmentId" id="hDepartmentId" />
        <input type="hidden" name="returnUrl" value="@(ViewBag.ReturnUrl ?? "")" />
        
        <div class="card shadow-sm mb-4">
            <div class="card-body bg-light">
                <div class="row align-items-center">
                    <label class="col-auto col-form-label fw-bold">Budget Year:</label>
                    <div class="col-auto">
                        <select name="BudgetYear" class="form-select" asp-items="ViewBag.BudgetYear" style="min-width: 120px;"></select>
                    </div>
                    <div class="col">
                        <span class="text-muted small">Select the fiscal year for the budget.</span>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Hierarchy Tree -->
    <div class="accordion" id="entityAccordion">
        @foreach (var entity in Model)
        {
            <div class="accordion-item mb-2 border rounded shadow-sm">
                <h2 class="accordion-header" id="heading-@entity.EntityId">
                    <button class="accordion-button collapsed fw-bold text-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@entity.EntityId" aria-expanded="false" aria-controls="collapse-@entity.EntityId">
                        <span class="badge bg-primary me-2">@entity.EntityCode</span> @entity.EntityName
                    </button>
                </h2>
                <div id="collapse-@entity.EntityId" class="accordion-collapse collapse show" aria-labelledby="heading-@entity.EntityId">
                    <div class="accordion-body p-0">
                        @if (entity.Departments != null && entity.Departments.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var dept in entity.Departments)
                                {
                                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 ps-5 js-select-dept"
                                            data-entity-id="@entity.EntityId" data-department-id="@dept.DepartmentId">
                                        <div>
                                            <span class="badge bg-secondary me-2">@dept.DeptCode</span>
                                            <span class="fw-medium">@dept.DeptName</span>
                                            <small class="text-muted ms-2">(Cost Center)</small>
                                        </div>
                                        <span class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Manage Budget &rarr;
                                        </span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-muted fst-italic ps-5">No active departments found.</div>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="alert alert-warning">No entities found available for your account.</div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Bind via delegated listeners (not inline onclick) so this works both on
        // a full page load and when the page is swapped in via htmx boosted
        // navigation, where inline scripts run in an isolated (non-global) scope.
        (function () {
            var form = document.getElementById('selectContextForm');
            if (!form) return;
            document.querySelectorAll('.js-select-dept').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('hEntityId').value = btn.getAttribute('data-entity-id');
                    document.getElementById('hDepartmentId').value = btn.getAttribute('data-department-id');
                    form.submit();
                });
            });
        })();
    </script>
}
