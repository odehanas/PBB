@model IEnumerable<GovBudget.Models.GLAccounts>

@{
    ViewData["Title"] = "GL Accounts";
    // Every admin may view the chart of accounts; adding, changing and uploading are for system admins only.
    var canManage = User.IsInRole("SYSADMIN");
}

<h1>GL Accounts</h1>

<div class="mb-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">&larr; Back to Admin Room</a>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <a asp-action="Template" class="btn btn-outline-primary">Download Template</a>
    }
</div>

@if (!canManage)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span><strong>View only.</strong> GL accounts are managed by the system administrator. If one you need is missing or wrong, send a request.</span>
        <a asp-controller="InternalMessages" asp-action="Index" asp-route-subject="Request: new or changed GL account" class="btn btn-sm btn-primary ms-auto">Request an addition or change</a>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
else if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="white-space: pre-line;">@TempData["Error"]</div>
}

@if (canManage)
{
<form asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-3">
    @Html.AntiForgeryToken()
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <input type="file" name="file" class="form-control" accept=".xlsx" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Upload Excel</button>
        </div>
    </div>
</form>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GLCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GLName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GLType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.GLCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GLName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GLType)
            </td>
            <td>
                @if (canManage)
                {
                    <a asp-action="Edit" asp-route-id="@item.GLAccountId">Edit</a> <span class="text-muted">|</span>
                    <a asp-action="Details" asp-route-id="@item.GLAccountId">Details</a> <span class="text-muted">|</span>
                    <a asp-action="Delete" asp-route-id="@item.GLAccountId">Delete</a>
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@item.GLAccountId">Details</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
