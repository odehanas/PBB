@model IEnumerable<GovBudget.Controllers.GuidesController.GuideDoc>

@{
    ViewData["Title"] = "User Guides";
    var isAdmin = User.IsInRole("ADMIN") || User.IsInRole("SYSADMIN");

    // End users only see End User + Reference guides; admins see everything.
    var visible = Model.Where(d => isAdmin || d.Category != "Administrator").ToList();

    // Preferred display order. Any category NOT named here still gets rendered,
    // appended after these — previously an unlisted category was silently dropped,
    // so adding a guide with a new category made it invisible with no error.
    var preferred = new[] { "Complete", "End User", "Administrator", "Reference" };
    var categoryOrder = preferred
        .Where(c => visible.Any(d => d.Category == c))
        .Concat(visible.Select(d => d.Category).Distinct().Where(c => !preferred.Contains(c)))
        .ToList();

    string CategoryBadge(string cat) => cat switch
    {
        "Administrator" => "bg-warning text-dark",
        "Reference" => "bg-secondary",
        _ => "bg-success"
    };
}

<div class="container-fluid py-3" style="max-width: 1100px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">User Guides</h1>
            <div class="text-muted">Step-by-step guidance and reference manuals for GovBudget. Guides open in a new tab.</div>
        </div>
    </div>

    @foreach (var cat in categoryOrder)
    {
        var items = visible.Where(d => d.Category == cat).ToList();
        if (items.Count == 0)
        {
            continue;
        }

        <h2 class="h5 mt-4 mb-2">@cat Guides</h2>
        <div class="row g-3">
            @foreach (var doc in items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h6 mb-0">@doc.Title</h3>
                                <span class="badge @CategoryBadge(doc.Category) ms-2">@doc.Lang</span>
                            </div>
                            <p class="text-muted small flex-grow-1">@doc.Description</p>
                            <div class="mt-2">
                                <a class="btn btn-sm btn-primary"
                                   href="@Url.Content("~/Guides/Content/" + doc.File)"
                                   target="_blank" rel="noopener">
                                    Open Guide
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (visible.Count == 0)
    {
        <div class="alert alert-info">No guides are available.</div>
    }
</div>
