@model GovBudget.Models.InternalMessages
@{
    ViewData["Title"] = "Requests";
    var myMessages = ViewBag.MyMessages as List<GovBudget.Models.InternalMessages> ?? new List<GovBudget.Models.InternalMessages>();
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Requests</h3>
        @if (ViewBag.ContextLabel != null)
        {
            <span class="text-muted small">Context: <strong>@ViewBag.ContextLabel</strong></span>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    else if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-header fw-bold">Send a request to Admin</div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="Subject" class="form-label"></label>
                    <input asp-for="Subject" class="form-control" maxlength="200" />
                    <span asp-validation-for="Subject" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Body" class="form-label">Message</label>
                    <textarea asp-for="Body" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Body" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Send</button>
            </form>
        </div>
    </div>

    <h5 class="text-secondary">My recent requests</h5>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead class="table-light">
                <tr>
                    <th>Created</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Admin Response</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in myMessages)
                {
                    <tr>
                        <td class="text-nowrap">@m.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@m.Subject</td>
                        <td class="text-nowrap">@m.Status</td>
                        <td>@(string.IsNullOrWhiteSpace(m.AdminResponse) ? "-" : m.AdminResponse)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
