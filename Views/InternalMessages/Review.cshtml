@model GovBudget.Models.InternalMessages
@{
    ViewData["Title"] = "Review Request";
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Review Request</h3>
        <a asp-action="AdminInbox" class="btn btn-sm btn-outline-secondary">Back</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-header fw-bold">@Model.Subject</div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="text-muted small">From</div>
                    <div>@Model.FromUser</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Entity</div>
                    <div>@Model.FromEntityCode</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Department</div>
                    <div>@Model.FromDeptCode</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Created</div>
                    <div>@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
            <div class="mb-2 text-muted small">Message</div>
            <div class="border rounded p-3 bg-light">@Model.Body</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-bold">Respond</div>
        <div class="card-body">
            <form asp-action="Respond" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MessageId" />
                <div class="mb-3">
                    <label class="form-label">Response</label>
                    <textarea name="adminResponse" class="form-control" rows="4">@Model.AdminResponse</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Send Response</button>
            </form>
        </div>
    </div>
</div>
