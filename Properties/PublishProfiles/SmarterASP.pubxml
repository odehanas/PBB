<?xml version="1.0" encoding="utf-8"?>
<!--
  GovBudget -> SmarterASP.NET, Web Deploy (one-click, incremental).

  WHY THIS FILE IS IN THE REPOSITORY
    A plain publish/zip/upload overwrites the whole site folder, which destroys the
    server-only files the app needs (secrets, key ring, logs). The skip rules below make
    that impossible, so a deploy is safe to repeat as often as management asks for changes.

  SETUP IS DONE - the server values below are filled in for site6 (odehanas-001-site6),
  which is the GovBudget site. Only the password is still needed, and it is asked for once:

    Visual Studio -> right-click the project -> Publish -> pick the "SmarterASP" profile
    -> Publish. Enter the hosting password when prompted and tick "Save password".
    Visual Studio writes it to SmarterASP.pubxml.user, which git ignores.

  NEVER put the password in this file - this one is committed.

  If the host ever moves the site to a different win####.site4now.net server, re-download
  the ".PublishSettings" from the control panel and update the three values below:
    publishUrl="..."   -> MSDeployServiceURL
    msdeploySite="..." -> DeployIisAppPath
    userName="..."     -> UserName

  EVERY DEPLOY AFTER THAT
    Visual Studio -> Publish -> Publish.  Or from a terminal:
      dotnet publish -c Release /p:PublishProfile=SmarterASP /p:Password=THEPASSWORD
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>

    <!--
      From site6's .PublishSettings (the GovBudget site - its FTP path is /GovBudget).
      Re-download the .PublishSettings from the control panel if the host ever moves the
      site to a different win####.site4now.net server.
    -->
    <MSDeployServiceURL>https://win8222.site4now.net:8172/msdeploy.axd?site=odehanas-001-site6</MSDeployServiceURL>
    <DeployIisAppPath>odehanas-001-site6</DeployIisAppPath>
    <UserName>odehanas-001</UserName>

    <!-- Shared hosts use a certificate that does not match the deploy endpoint. -->
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
    <!-- Password lives in SmarterASP.pubxml.user, never here. -->
    <_SavePWD>true</_SavePWD>

    <!--
      Web Deploy drops app_offline.htm before copying and removes it afterwards. That is
      what releases the locked GovBudget.dll, so "file in use" errors stop happening.
    -->
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>

    <!--
      TRUE = leave files that exist on the server but not in the publish output.
      This is the safety net: nothing on the server is deleted by a deploy. The cost is
      that a file you delete from the project stays behind on the server until you remove
      it by hand - see "Removing a stale file" in docs/DEPLOY.md.
    -->
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>

    <ExcludeApp_Data>true</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>https://govbudget.odehanas.com</SiteUrlToLaunchAfterPublish>
  </PropertyGroup>

  <!-- Belt-and-braces: keep these out of the publish payload in the first place. -->
  <PropertyGroup>
    <ExcludeFilesFromDeployment>appsettings.Production.json;appsettings.Local.json;app_offline.htm</ExcludeFilesFromDeployment>
    <!--
      App_Data only. "logs" is deliberately NOT excluded any more: excluding the whole
      folder stopped logs\.keep from shipping, so the folder never existed on the server
      and had to be created by hand before stdout logging could be switched on. The
      SkipLogFiles rule below already protects the actual .log files from being touched,
      which is the part that matters - so ship the empty folder, keep the contents safe.
    -->
    <ExcludeFoldersFromDeployment>App_Data</ExcludeFoldersFromDeployment>
  </PropertyGroup>

  <!--
    Skip rules are enforced by msdeploy itself on the DESTINATION, so they win even if a
    file somehow ends up in the payload. An empty SkipAction blocks every action on the
    match: no add, no update, no delete. AbsolutePath is a regular expression.
  -->
  <ItemGroup>
    <!-- Live secrets: OpenAI key, connection string overrides. Set up once on the server. -->
    <MsDeploySkipRules Include="SkipProductionSettings">
      <SkipAction></SkipAction>
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>appsettings\.Production\.json</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipLocalSettings">
      <SkipAction></SkipAction>
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>appsettings\.Local\.json</AbsolutePath>
    </MsDeploySkipRules>

    <!-- Data-protection key ring. Overwriting it signs every user out instantly. -->
    <MsDeploySkipRules Include="SkipAppDataFolder">
      <SkipAction></SkipAction>
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>App_Data</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipAppDataFiles">
      <SkipAction></SkipAction>
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>App_Data\\</AbsolutePath>
    </MsDeploySkipRules>

    <!-- stdout logs: server-side diagnostics, no reason to touch them. -->
    <MsDeploySkipRules Include="SkipLogFiles">
      <SkipAction></SkipAction>
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>logs\\.*\.log</AbsolutePath>
    </MsDeploySkipRules>

    <!-- Anything an operator uploaded into the site root by hand. -->
    <MsDeploySkipRules Include="SkipUploads">
      <SkipAction></SkipAction>
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>App_Uploads</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
