<?xml version="1.0" encoding="utf-8"?>
<!--
  GovBudget -> SmarterASP.NET, FTP fallback.

  Use this ONLY if Web Deploy is not enabled on the hosting plan (try SmarterASP.pubxml
  first - it is faster and it takes the app offline for you).

  Differences from Web Deploy:
    - Uploads every file each time, not just the changed ones (slower).
    - Does NOT create app_offline.htm, so a locked GovBudget.dll can fail the upload.
      If that happens: put an app_offline.htm in the site root, publish, then delete it.
    - Has no msdeploy skip rules, so protection relies on DeleteExistingFiles=False plus
      the ExcludeFilesFromDeployment list below. Never set DeleteExistingFiles to True:
      that is exactly what wipes appsettings.Production.json and the App_Data key ring.

  SETUP IS DONE - the FTP host and user below are filled in for site6, the GovBudget site.
  Visual Studio -> Publish -> SmarterASP-FTP, then tick "Save password" so it goes into the
  ignored .pubxml.user file. Never put the password in this file - it is committed.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FTP</WebPublishMethod>
    <PublishProvider>FTP</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>

    <!-- From site6's .PublishSettings. The /GovBudget suffix is the site's root folder. -->
    <PublishUrl>ftp://win8222.site4now.net:21/GovBudget</PublishUrl>
    <UserName>odehanas-001</UserName>
    <_SavePWD>true</_SavePWD>

    <FtpPassiveMode>true</FtpPassiveMode>
    <!-- MUST stay false. True deletes server-only files. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>

    <ExcludeApp_Data>true</ExcludeApp_Data>
    <ExcludeFilesFromDeployment>appsettings.Production.json;appsettings.Local.json;app_offline.htm</ExcludeFilesFromDeployment>
    <!--
      App_Data only - see the note in SmarterASP.pubxml. Excluding "logs" prevented
      logs\.keep from ever reaching the server, which is why the folder had to be created
      by hand. FTP has no skip rules, but DeleteExistingFiles=false already means existing
      .log files on the server are left alone.
    -->
    <ExcludeFoldersFromDeployment>App_Data</ExcludeFoldersFromDeployment>

    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <SiteUrlToLaunchAfterPublish>https://govbudget.odehanas.com</SiteUrlToLaunchAfterPublish>
  </PropertyGroup>
</Project>
