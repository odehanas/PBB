<?xml version="1.0" encoding="utf-8"?>
<!--
  Checked into the project on purpose.

  When this file does not exist, "dotnet publish" GENERATES a fresh web.config on every
  publish, which is why hand-made server edits kept disappearing after each deployment.
  Because it exists, publish only TRANSFORMS it (it rewrites processPath / arguments to
  match the built assembly) and leaves everything else below untouched.

  So: make server settings here, commit them, and every future publish keeps them.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled is false by design: the log file grows without limit and is only
        useful for start-up failures. Set it to true temporarily when the site will not
        start, check .\logs\stdout_*.log, then set it back to false.
        The .\logs folder ships with the publish output (see logs\.keep), so it no longer
        has to be created by hand on the server.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\GovBudget.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
